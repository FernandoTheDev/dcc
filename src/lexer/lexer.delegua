// Fase 1 + Fase 6 (concatenacao de strings adjacentes): Lexer ISO C99 / GNU99 para o DCC.
// Usa dicionarios O(1), rastreamento exato de linha/coluna, bytes exatos em literais string
// (preservando '\0', octais e '\xNN'), literais hex-float C99 e diagnosticos estruturados.

classe TokenC99 {
    tag: qualquer
    lexema: texto
    bytesStr: qualquer
    linha: inteiro
    coluna: inteiro
    valorInt: inteiro
    valorReal: real
    ehSemSinal: logico
    ehLongo: logico
    ehFloat32: logico

    construtor(tag: qualquer, lexema: texto, linha: inteiro, coluna: inteiro) {
        isto.tag = tag
        isto.lexema = lexema
        isto.bytesStr = nulo
        isto.linha = linha
        isto.coluna = coluna
        isto.valorInt = 0
        isto.valorReal = 0.0
        isto.ehSemSinal = falso
        isto.ehLongo = falso
        isto.ehFloat32 = falso
    }
}

funcao parseFloatDecimal(lex: texto, diag: qualquer, linha: inteiro, col: inteiro): (real,
    logico) {
    var fim: inteiro = lex.tamanho()
    var ehF32: logico = falso
    enquanto (fim > 0) {
        const ch: texto = lex[fim - 1]
        se (ch == "f" ou ch == "F") {
            ehF32 = verdadeiro
            fim--
        } senao se (ch == "l" ou ch == "L") {
            fim--
        } senao {
            sustar
        }
    }

    const limpo: texto = lex.fatiar(0, fim)
    tente {
        retorna tupla([real(limpo), ehF32])
    } pegue (erro: Excecao) {
        diag.erroEm(linha, col, "literal de ponto flutuante invalido '${lex}'", "", "E2003",
            lex.tamanho())
        retorna tupla([0.0, ehF32])
    }
}

classe LexerDCC {
    tMod: qualquer
    litMod: qualquer
    cls: qualquer
    bytesMod: qualquer
    Tok: qualquer
    diag: qualquer
    modoGnu: logico
    keywords: dicionario
    opsTriplos: dicionario
    opsDuplos: dicionario
    opsSimples: dicionario
    opsSimplesTag: qualquer[]
    opsSimplesLex: texto[]
    internIds: dicionario

    construtor(diag: qualquer, modoGnu: logico = falso) {
        isto.tMod = importar("../types/tipos.delegua")
        isto.litMod = importar("literais.delegua")
        isto.cls = isto.litMod.ClassificadorChar()
        isto.bytesMod = importar("cgd:bytes")
        isto.Tok = isto.tMod.TokC99
        isto.diag = diag
        isto.modoGnu = modoGnu

        isto.keywords = {
            "void": isto.Tok.KwVoid,
            "_Bool": isto.Tok.KwBool,
            "char": isto.Tok.KwChar,
            "short": isto.Tok.KwShort,
            "int": isto.Tok.KwInt,
            "long": isto.Tok.KwLong,
            "signed": isto.Tok.KwSigned,
            "__signed": isto.Tok.KwSigned,
            "__signed__": isto.Tok.KwSigned,
            "unsigned": isto.Tok.KwUnsigned,
            "float": isto.Tok.KwFloat,
            "double": isto.Tok.KwDouble,
            "_Float32": isto.Tok.KwFloat32,
            "_Float64": isto.Tok.KwFloat64,
            "_Float32x": isto.Tok.KwFloat32x,
            "_Float64x": isto.Tok.KwFloat64x,
            "__builtin_va_list": isto.Tok.KwBuiltinVaList,
            "const": isto.Tok.KwConst,
            "__const": isto.Tok.KwConst,
            "__const__": isto.Tok.KwConst,
            "volatile": isto.Tok.KwVolatile,
            "__volatile": isto.Tok.KwVolatile,
            "__volatile__": isto.Tok.KwVolatile,
            "restrict": isto.Tok.KwRestrict,
            "__restrict": isto.Tok.KwRestrict,
            "__restrict__": isto.Tok.KwRestrict,
            "inline": isto.Tok.KwInline,
            "__inline": isto.Tok.KwInline,
            "__inline__": isto.Tok.KwInline,
            "extern": isto.Tok.KwExtern,
            "__thread": isto.Tok.KwThreadLocal,
            "_Thread_local": isto.Tok.KwThreadLocal,
            "static": isto.Tok.KwStatic,
            "auto": isto.Tok.KwAuto,
            "register": isto.Tok.KwRegister,
            "struct": isto.Tok.KwStruct,
            "union": isto.Tok.KwUnion,
            "enum": isto.Tok.KwEnum,
            "typedef": isto.Tok.KwTypedef,
            "sizeof": isto.Tok.KwSizeof,
            "_Alignof": isto.Tok.KwAlignof,
            "__alignof": isto.Tok.KwAlignof,
            "__alignof__": isto.Tok.KwAlignof,
            "__attribute__": isto.Tok.KwAttribute,
            "__attribute": isto.Tok.KwAttribute,
            "__extension__": isto.Tok.KwExtension,
            "__asm__": isto.Tok.KwAsm,
            "__asm": isto.Tok.KwAsm,
            "__typeof__": isto.Tok.KwTypeof,
            "__typeof": isto.Tok.KwTypeof,
            "if": isto.Tok.KwIf,
            "else": isto.Tok.KwElse,
            "while": isto.Tok.KwWhile,
            "do": isto.Tok.KwDo,
            "for": isto.Tok.KwFor,
            "switch": isto.Tok.KwSwitch,
            "case": isto.Tok.KwCase,
            "default": isto.Tok.KwDefault,
            "break": isto.Tok.KwBreak,
            "continue": isto.Tok.KwContinue,
            "goto": isto.Tok.KwGoto,
            "return": isto.Tok.KwReturn
        }

        se (modoGnu) {
            isto.keywords["asm"] = isto.Tok.KwAsm
            isto.keywords["typeof"] = isto.Tok.KwTypeof
        }

        isto.opsTriplos = {
            "...": isto.Tok.Ellipsis,
            "<<=": isto.Tok.ShlIgual,
            ">>=": isto.Tok.ShrIgual
        }

        isto.opsDuplos = {
            "->": isto.Tok.Arrow,
            "++": isto.Tok.Inc,
            "--": isto.Tok.Dec,
            "+=": isto.Tok.MaisIgual,
            "-=": isto.Tok.MenosIgual,
            "*=": isto.Tok.VezesIgual,
            "/=": isto.Tok.DivIgual,
            "%=": isto.Tok.ModIgual,
            "&=": isto.Tok.AndIgual,
            "|=": isto.Tok.OrIgual,
            "^=": isto.Tok.XorIgual,
            "==": isto.Tok.Eq,
            "!=": isto.Tok.Neq,
            "<=": isto.Tok.Le,
            ">=": isto.Tok.Ge,
            "<<": isto.Tok.Shl,
            ">>": isto.Tok.Shr,
            "&&": isto.Tok.AndLog,
            "||": isto.Tok.OrLog
        }

        isto.opsSimples = {
            "+": isto.Tok.Mais,
            "-": isto.Tok.Menos,
            "*": isto.Tok.Vezes,
            "/": isto.Tok.Div,
            "%": isto.Tok.Mod,
            "=": isto.Tok.Igual,
            "<": isto.Tok.Lt,
            ">": isto.Tok.Gt,
            "!": isto.Tok.NotLog,
            "&": isto.Tok.BitAnd,
            "|": isto.Tok.BitOr,
            "^": isto.Tok.BitXor,
            "~": isto.Tok.BitNot,
            "?": isto.Tok.Interrog,
            ":": isto.Tok.Colon,
            ".": isto.Tok.Dot,
            "(": isto.Tok.LParen,
            ")": isto.Tok.RParen,
            "{": isto.Tok.LBrace,
            "}": isto.Tok.RBrace,
            "[": isto.Tok.LBracket,
            "]": isto.Tok.RBracket,
            ";": isto.Tok.Semi,
            ",": isto.Tok.Comma
        }

        isto.opsSimplesTag = []
        isto.opsSimplesLex = []
        isto.internIds = {}
        para (var bi: inteiro = 0; bi < 128; bi++) {
            isto.opsSimplesTag.empilhar(nulo)
            isto.opsSimplesLex.empilhar("")
        }
        const chavesOp: texto[] = isto.opsSimples.chaves()
        para (var ki: inteiro = 0; ki < chavesOp.tamanho(); ki++) {
            const kStr: texto = chavesOp[ki]
            const kb: inteiro = isto.cls.codigo(kStr)
            se (kb >= 0 e kb < 128) {
                isto.opsSimplesTag[kb] = isto.opsSimples[kStr]
                isto.opsSimplesLex[kb] = kStr
            }
        }
    }

    tokenizar(fonte: texto): TokenC99[] {
        var out: TokenC99[] = []
        const linhasTexto: texto[] = fonte.dividir("\n")
        var emComentarioBloco: logico = falso
        para (var numLin: inteiro = 1; numLin <= linhasTexto.tamanho(); numLin++) {
            emComentarioBloco = isto.tokenizarLinha(linhasTexto[numLin - 1], numLin, out,
                emComentarioBloco)
        }
        se (emComentarioBloco) {
            isto.diag.erroEm(linhasTexto.tamanho(), 1, "comentario de bloco nao fechado",
                "", "E2001", 2)
        }
        out.empilhar(TokenC99(isto.Tok.Fim, "<fim>", linhasTexto.tamanho(), 1))
        retorna out
    }

    tokenizarLinha(fonte: texto, linha: inteiro, out: qualquer, emBlocoIni: logico): logico {
        const raw: qualquer = isto.bytesMod.Bytes.deTexto(fonte)
        var pos: inteiro = 0
        var col: inteiro = 1
        var emBloco: logico = emBlocoIni
        const n: inteiro = raw.tamanho()

        enquanto (pos < n) {
            se (emBloco) {
                se (pos + 1 < n e raw.obter(pos) == 42 e raw.obter(pos + 1) == 47) {
                    emBloco = falso
                    pos = pos + 2
                    col = col + 2
                } senao {
                    pos++
                    col++
                }
                continua
            }
            const b: inteiro = raw.obter(pos)
            se (b == 32 ou b == 9 ou b == 13) {
                pos++
                col++
                continua
            }
            se (b == 47 e pos + 1 < n e raw.obter(pos + 1) == 47) {
                retorna falso
            }
            se (b == 47 e pos + 1 < n e raw.obter(pos + 1) == 42) {
                emBloco = verdadeiro
                pos = pos + 2
                col = col + 2
                continua
            }

            // Prefixo L'...' para caractere largo (tratado como constante inteira wchar_t)
            se (b == 76 e pos + 1 < n e raw.obter(pos + 1) == 39) {
                pos++
                col++
                continua
            }

            // String literal (com bytes exatos e concatenacao automatica - C99 Fase 6)
            se (b == 34) {
                const colIni: inteiro = col
                const linIni: inteiro = linha
                pos++
                col++
                var visBytes: inteiro[] = []
                var bytesOut: inteiro[] = []
                var fechouStr: logico = falso
                enquanto (pos < n) {
                    const ch: inteiro = raw.obter(pos)
                    se (ch == 34) {
                        pos++
                        col++
                        fechouStr = verdadeiro
                        sustar
                    }
                    se (ch == 92 e pos + 1 < n) {
                        const dec: (inteiro, inteiro) = isto.litMod.decodificarEscapeBytesC99(raw,
                            pos + 1, n)
                        const bVal: inteiro = dec[0] & 255
                        const cons: inteiro = dec[1]
                        bytesOut.empilhar(bVal)
                        se (bVal >= 32 e bVal <= 126) {
                            visBytes.empilhar(bVal)
                        }
                        pos = pos + 1 + cons
                        col = col + 1 + cons
                        continua
                    }
                    bytesOut.empilhar(ch & 255)
                    se (ch >= 32 e ch <= 126) visBytes.empilhar(ch)
                    pos++
                    col++
                }
                se (!fechouStr) {
                    isto.diag.erroEm(linIni, colIni, "string literal nao terminada", "",
                        "E2002", 1)
                }
                const valorStr: texto = visBytes.tamanho() > 0 ? isto.bytesMod.Bytes.deVetor(visBytes).paraTexto() : ""
                se (out.tamanho() > 0 e out[out.tamanho() - 1].tag == isto.Tok.StrLit) {
                    const prevT: TokenC99 = out[out.tamanho() - 1]
                    prevT.lexema = prevT.lexema + valorStr
                    para (var bi: inteiro = 0; bi < bytesOut.tamanho(); bi++) {
                        prevT.bytesStr.empilhar(bytesOut[bi])
                    }
                } senao {
                    const tokS: TokenC99 = TokenC99(isto.Tok.StrLit, valorStr, linIni, colIni)
                    tokS.bytesStr = bytesOut
                    out.empilhar(tokS)
                }
                continua
            }

            // Char literal: 'a', '\n', '\0', '\012', '\x41'
            se (b == 39) {
                const colIni: inteiro = col
                pos++
                col++
                se (pos < n e raw.obter(pos) == 39) {
                    isto.diag.erroEm(linha, colIni, "caractere literal vazio ''", "", "E2004",
                        2)
                }
                var codigo: inteiro = 0
                se (pos < n e raw.obter(pos) == 92) {
                    const decC: (inteiro, inteiro) = isto.litMod.decodificarEscapeBytesC99(raw,
                        pos + 1, n)
                    codigo = decC[0]
                    pos = pos + 1 + decC[1]
                    col = col + 1 + decC[1]
                } senao se (pos < n) {
                    codigo = raw.obter(pos) & 255
                    pos++
                    col++
                }
                se (pos >= n ou raw.obter(pos) != 39) {
                    isto.diag.erroEm(linha, colIni, "caractere literal nao terminado", "",
                        "E2004", 1)
                }
                pos++
                col++
                const tokC: TokenC99 = TokenC99(isto.Tok.CharLit, texto(codigo), linha, colIni)
                tokC.valorInt = codigo
                out.empilhar(tokC)
                continua
            }

            // Numeros inteiros e ponto flutuante (decimal, octal, binario, hex, hex-float C99)
            se ((b >= 48 e b <= 57) ou (b == 46 e pos + 1 < n e raw.obter(pos + 1) >= 48 e raw.obter(pos + 1) <= 57)) {
                const colIni: inteiro = col
                const posIni: inteiro = pos
                var ehFloat: logico = falso
                var ehHex: logico = falso
                se (b == 48 e pos + 1 < n e (raw.obter(pos + 1) == 120 ou raw.obter(pos + 1) == 88)) {
                    ehHex = verdadeiro
                    pos = pos + 2
                    col = col + 2
                    enquanto (pos < n) {
                        const chH: inteiro = raw.obter(pos)
                        se ((chH >= 48 e chH <= 57) ou (chH >= 65 e chH <= 70) ou (chH >= 97 e chH <= 102)) {
                            pos++
                            col++
                        } senao {
                            sustar
                        }
                    }
                    se (pos < n e raw.obter(pos) == 46) {
                        ehFloat = verdadeiro
                        pos++
                        col++
                        enquanto (pos < n) {
                            const chH2: inteiro = raw.obter(pos)
                            se ((chH2 >= 48 e chH2 <= 57) ou (chH2 >= 65 e chH2 <= 70) ou (chH2 >= 97 e chH2 <= 102)) {
                                pos++
                                col++
                            } senao {
                                sustar
                            }
                        }
                    }
                    se (pos < n e (raw.obter(pos) == 112 ou raw.obter(pos) == 80)) {
                        ehFloat = verdadeiro
                        pos++
                        col++
                        se (pos < n e (raw.obter(pos) == 43 ou raw.obter(pos) == 45)) {
                            pos++
                            col++
                        }
                        enquanto (pos < n e raw.obter(pos) >= 48 e raw.obter(pos) <= 57) {
                            pos++
                            col++
                        }
                    }
                    se (ehFloat) {
                        enquanto (pos < n) {
                            const sfH: inteiro = raw.obter(pos)
                            se (sfH == 102 ou sfH == 70 ou sfH == 108 ou sfH == 76) {
                                pos++
                                col++
                            } senao {
                                sustar
                            }
                        }
                    } senao {
                        enquanto (pos < n) {
                            const siH: inteiro = raw.obter(pos)
                            se (siH == 117 ou siH == 85 ou siH == 108 ou siH == 76) {
                                pos++
                                col++
                            } senao {
                                sustar
                            }
                        }
                    }
                } senao se (b == 48 e pos + 1 < n e (raw.obter(pos + 1) == 98 ou raw.obter(pos + 1) == 66)) {
                    pos = pos + 2
                    col = col + 2
                    enquanto (pos < n) {
                        const chB: inteiro = raw.obter(pos)
                        se (chB == 48 ou chB == 49 ou chB == 117 ou chB == 85 ou chB == 108 ou chB == 76) {
                            pos++
                            col++
                        } senao {
                            sustar
                        }
                    }
                } senao {
                    enquanto (pos < n e raw.obter(pos) >= 48 e raw.obter(pos) <= 57) {
                        pos++
                        col++
                    }
                    se (pos < n e raw.obter(pos) == 46) {
                        ehFloat = verdadeiro
                        pos++
                        col++
                        enquanto (pos < n e raw.obter(pos) >= 48 e raw.obter(pos) <= 57) {
                            pos++
                            col++
                        }
                    }
                    se (pos < n e (raw.obter(pos) == 101 ou raw.obter(pos) == 69)) {
                        ehFloat = verdadeiro
                        pos++
                        col++
                        se (pos < n e (raw.obter(pos) == 43 ou raw.obter(pos) == 45)) {
                            pos++
                            col++
                        }
                        var digExp: inteiro = 0
                        enquanto (pos < n e raw.obter(pos) >= 48 e raw.obter(pos) <= 57) {
                            pos++
                            col++
                            digExp++
                        }
                        se (digExp == 0) {
                            const lexBad: texto = raw.fatiarTexto(posIni, pos)
                            isto.diag.erroEm(linha, colIni, "expoente sem digitos em literal de ponto flutuante '${lexBad}'",
                                "", "E2003", lexBad.tamanho())
                        }
                    }
                    se (ehFloat) {
                        enquanto (pos < n) {
                            const sfD: inteiro = raw.obter(pos)
                            se (sfD == 102 ou sfD == 70 ou sfD == 108 ou sfD == 76) {
                                pos++
                                col++
                            } senao {
                                sustar
                            }
                        }
                    } senao {
                        enquanto (pos < n) {
                            const siD: inteiro = raw.obter(pos)
                            se (siD == 117 ou siD == 85 ou siD == 108 ou siD == 76) {
                                pos++
                                col++
                            } senao {
                                sustar
                            }
                        }
                    }
                }
                const lex: texto = raw.fatiarTexto(posIni, pos)
                se (ehFloat) {
                    const tokF: TokenC99 = TokenC99(isto.Tok.FloatLit, lex, linha, colIni)
                    se (ehHex) {
                        const hf: (real, logico) = isto.litMod.parseHexFloatC99(lex)
                        se (!hf[1]) {
                            isto.diag.erroEm(linha, colIni, "literal hexadecimal de ponto flutuante invalido '${lex}'",
                                "", "E2003", lex.tamanho())
                        }
                        tokF.valorReal = hf[0]
                        const ultB: inteiro = raw.obter(pos - 1)
                        tokF.ehFloat32 = ultB == 102 ou ultB == 70
                    } senao {
                        const df: (real, logico) = parseFloatDecimal(lex, isto.diag, linha,
                            colIni)
                        tokF.valorReal = df[0]
                        tokF.ehFloat32 = df[1]
                    }
                    out.empilhar(tokF)
                } senao {
                    const infoI: (inteiro, logico, logico) = isto.litMod.parseInteiroC99(lex)
                    const tokI: TokenC99 = TokenC99(isto.Tok.IntLit, lex, linha, colIni)
                    tokI.valorInt = infoI[0]
                    tokI.ehSemSinal = infoI[1]
                    tokI.ehLongo = infoI[2]
                    out.empilhar(tokI)
                }
                continua
            }

            // Identificadores e keywords (com internamento de identificadores)
            se ((b >= 65 e b <= 90) ou (b >= 97 e b <= 122) ou b == 95 ou b == 36) {
                const colIni: inteiro = col
                const posIni: inteiro = pos
                pos++
                col++
                enquanto (pos < n) {
                    const cId: inteiro = raw.obter(pos)
                    se ((cId >= 65 e cId <= 90) ou (cId >= 97 e cId <= 122) ou (cId >= 48 e cId <= 57) ou cId == 95 ou cId == 36) {
                        pos++
                        col++
                    } senao {
                        sustar
                    }
                }
                var lexId: texto = raw.fatiarTexto(posIni, pos)
                se (isto.internIds.contem(lexId)) {
                    lexId = texto(isto.internIds[lexId])
                } senao {
                    isto.internIds[lexId] = lexId
                }
                const tagKw: qualquer = isto.keywords.contem(lexId) ? isto.keywords[lexId] : isto.Tok.Ident
                out.empilhar(TokenC99(tagKw, lexId, linha, colIni))
                continua
            }

            // Operadores de 3 caracteres
            se (pos + 2 < n e (b == 46 ou b == 60 ou b == 62)) {
                const tri: texto = raw.fatiarTexto(pos, pos + 3)
                se (isto.opsTriplos.contem(tri)) {
                    out.empilhar(TokenC99(isto.opsTriplos[tri], tri, linha, col))
                    pos = pos + 3
                    col = col + 3
                    continua
                }
            }

            // Operadores de 2 caracteres
            se (pos + 1 < n) {
                const b2: inteiro = raw.obter(pos + 1)
                se (b2 == 61 ou b2 == 62 ou b2 == 60 ou b2 == 43 ou b2 == 45 ou b2 == 38 ou b2 == 124) {
                    const par: texto = raw.fatiarTexto(pos, pos + 2)
                    se (isto.opsDuplos.contem(par)) {
                        out.empilhar(TokenC99(isto.opsDuplos[par], par, linha, col))
                        pos = pos + 2
                        col = col + 2
                        continua
                    }
                }
            }

            // Operadores de 1 caractere (tabela ASCII O(1) sem alocacao de Bytes)
            se (b >= 0 e b < 128 e isto.opsSimplesTag[b] != nulo) {
                out.empilhar(TokenC99(isto.opsSimplesTag[b], isto.opsSimplesLex[b], linha,
                    col))
                pos++
                col++
                continua
            }

            const c1: texto = raw.fatiarTexto(pos, pos + 1)
            isto.diag.erroEm(linha, col, "caractere invalido '${c1}'", "", "E2005", 1)
        }

        retorna emBloco
    }
}

funcao tokenizarDCC(fonte: texto, diag: qualquer, modoGnu: logico = falso): TokenC99[] {
    retorna LexerDCC(diag, modoGnu).tokenizar(fonte)
}
