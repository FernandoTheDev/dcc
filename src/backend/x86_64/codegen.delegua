// Backend x86-64 (System V AMD64 ABI): Lowering direto de ModuloSSA para CodigoObjeto PIC-compativel.
// Suporta float 32-bit vs double 64-bit na ABI, comparacoes NaN IEEE-754, operacoes 32/64-bit,
// UItoF/FtoUI, structs por valor (<=8B, 9..16B em rax:rdx, >16B via pilha/sret) e relocacoes .rela.data.

funcao offRegObj(tamanhoLocaisBytes: inteiro, reg: inteiro): inteiro {
    retorna tamanhoLocaisBytes + (reg + 1) * 8
}

funcao emitirCallObj(emissor: qualquer, fn: qualquer, inst: qualquer, ehExtern: logico, ehIndireto: logico,
    regOff: inteiro[]): vazio {
    const ci: qualquer = inst.callInfo
    var intIdx: inteiro = 0
    var fltIdx: inteiro = 0

    // Se retorno eh struct > 16B (sret), rdi recebe o ponteiro oculto de destino
    var temSret: logico = ci.retStructModo == 3 e ci.sretReg >= 0
    se (temSret) {
        intIdx = 1
    }

    // Classifica argumentos conforme System V AMD64 ABI
    // Cada item de stackOps: tupla([tipoOp, slotOff, qwordDisp])
    // tipoOp: 0 = escalar/double no slot, 1 = float32 no slot (converter), 2 = qword de struct apontada pelo slot
    var stackOps: qualquer[] = []
    var regIntOps: qualquer[] = [] // tupla([regIdx, tipoOp, slotOff, qwordDisp])
    var regFltOps: qualquer[] = [] // tupla([xmmIdx, ehFloat32, slotOff])

    para (var k: inteiro = 0; k < ci.args.tamanho(); k++) {
        const regArg: inteiro = ci.args[k]
        const slotArg: inteiro = regOff[regArg]
        const ehFlt: logico = k < ci.argFloats.tamanho() ? ci.argFloats[k] : falso
        const largA: inteiro = k < ci.argLarguras.tamanho() ? ci.argLarguras[k] : 8
        const ehStructA: logico = k < ci.argEhStruct.tamanho() ? ci.argEhStruct[k] : falso

        se (ehStructA) {
            se (largA <= 8) {
                se (intIdx < 6) {
                    regIntOps.empilhar(tupla([intIdx, 2, slotArg, 0]))
                    intIdx++
                } senao {
                    stackOps.empilhar(tupla([2, slotArg, 0]))
                }
            } senao se (largA <= 16) {
                se (intIdx + 2 <= 6) {
                    regIntOps.empilhar(tupla([intIdx, 2, slotArg, 0]))
                    regIntOps.empilhar(tupla([intIdx + 1, 2, slotArg, 8]))
                    intIdx = intIdx + 2
                } senao {
                    stackOps.empilhar(tupla([2, slotArg, 0]))
                    stackOps.empilhar(tupla([2, slotArg, 8]))
                }
            } senao {
                const nQwords: inteiro = (largA + 7) \ 8
                para (var q: inteiro = 0; q < nQwords; q++) {
                    stackOps.empilhar(tupla([2, slotArg, q * 8]))
                }
            }
            continua
        }

        se (ehFlt) {
            const ehF32: logico = largA == 4
            se (fltIdx < 8) {
                regFltOps.empilhar(tupla([fltIdx, ehF32, slotArg]))
                fltIdx++
            } senao {
                stackOps.empilhar(tupla([ehF32 ? 1 : 0, slotArg, 0]))
            }
        } senao {
            se (intIdx < 6) {
                regIntOps.empilhar(tupla([intIdx, 0, slotArg, 0]))
                intIdx++
            } senao {
                stackOps.empilhar(tupla([0, slotArg, 0]))
            }
        }
    }

    const padStack: inteiro = stackOps.tamanho() % 2 == 1 ? 8 : 0
    se (padStack > 0) emissor.subRspImm32(8)

    // Empilha argumentos excedentes da direita para a esquerda
    para (var s: inteiro = stackOps.tamanho() - 1; s >= 0; s--) {
        const opS: qualquer = stackOps[s]
        const tipoS: inteiro = inteiro(opS[0])
        const slotS: inteiro = inteiro(opS[1])
        const dispS: inteiro = inteiro(opS[2])
        se (tipoS == 2) {
            emissor.loadRaxRbp(slotS)
            emissor.loadR11FromRaxDisp(dispS)
            emissor.pushR11()
        } senao se (tipoS == 1) {
            // float32 na pilha: converte double -> float em xmm0, move bits 32-bit para eax e push rax
            emissor.cvtsd2ssXmmFromRbpDisp(0, -slotS)
            // movd eax, xmm0 -> 66 0F 7E C0
            emissor.u8(102)
            emissor.u8(15)
            emissor.u8(126)
            emissor.u8(192)
            emissor.pushRax()
        } senao {
            emissor.loadRaxRbp(slotS)
            emissor.pushRax()
        }
    }

    // Carrega argumentos GP (rdi..r9)
    se (temSret) {
        emissor.loadArgAbiRbp(0, regOff[ci.sretReg])
    }

    para (var i: inteiro = 0; i < regIntOps.tamanho(); i++) {
        const opI: qualquer = regIntOps[i]
        const rIdx: inteiro = inteiro(opI[0])
        const tOp: inteiro = inteiro(opI[1])
        const slI: inteiro = inteiro(opI[2])
        const dsI: inteiro = inteiro(opI[3])
        se (tOp == 2) {
            emissor.loadRaxRbp(slI)
            emissor.loadArgAbiFromRaxDisp(rIdx, dsI)
        } senao {
            emissor.loadArgAbiRbp(rIdx, slI)
        }
    }

    // Carrega argumentos SSE (xmm0..xmm7)
    para (var i: inteiro = 0; i < regFltOps.tamanho(); i++) {
        const opF: qualquer = regFltOps[i]
        const xIdx: inteiro = inteiro(opF[0])
        const ehF32: logico = opF[1]
        const slF: inteiro = inteiro(opF[2])
        se (ehF32) {
            emissor.cvtsd2ssXmmFromRbpDisp(xIdx, -slF)
        } senao {
            emissor.loadXmmRbpDisp(xIdx, -slF)
        }
    }

    se (ehIndireto) {
        emissor.callIndirectRbp(regOff[inst.a], fltIdx)
    } senao se (ehExtern) {
        emissor.callExternReloc(inst.alvo1, fltIdx)
    } senao {
        emissor.movEaxImm32(fltIdx)
        emissor.callLabel("fn_" + inst.alvo1)
    }

    const totalPop: inteiro = stackOps.tamanho() * 8 + padStack
    se (totalPop > 0) emissor.addRspImm32(totalPop)

    se (inst.dst >= 0) {
        se (inst.ehFloatDst) {
            se (inst.largura == 4) {
                emissor.cvtss2sdXmm0()
            }
            emissor.storeXmmRbpDisp(0, -regOff[inst.dst])
        } senao {
            emissor.storeRaxRbp(regOff[inst.dst])
            se (inst.dst2 >= 0) {
                emissor.storeRdxRbp(regOff[inst.dst2])
            }
        }
    }
}

classe ContextoCodegenStreaming {
    obj: qualquer
    emissor: qualquer
    strOffsets: inteiro[]
    nStringsSinc: inteiro
    nGlobaisSinc: inteiro
    funcoesLocais: dicionario
    funcoesWeak: dicionario
    mapaGlobalSec: dicionario
    mapaGlobalOff: dicionario
    globaisWeak: dicionario
    externosExtras: dicionario
    externosTls: dicionario
    simbolosFuncoes: qualquer[]

    construtor(funcoesLocais: dicionario, funcoesWeak: dicionario) {
        const emMod: qualquer = importar("emissor.delegua")
        isto.obj = emMod.CodigoObjeto()
        isto.emissor = emMod.EmissorX86_64()
        isto.strOffsets = []
        isto.nStringsSinc = 0
        isto.nGlobaisSinc = 0
        isto.funcoesLocais = funcoesLocais
        isto.funcoesWeak = funcoesWeak
        isto.mapaGlobalSec = {}
        isto.mapaGlobalOff = {}
        isto.globaisWeak = {}
        isto.externosExtras = {}
        isto.externosTls = {}
        isto.simbolosFuncoes = []
    }
}

funcao sincronizarModuloStreaming(ctx: ContextoCodegenStreaming, modulo: qualquer): vazio {
    const emMod: qualquer = importar("emissor.delegua")
    const elfComum: qualquer = importar("../../object/elf/elf_comum.delegua")
    const obj: qualquer = ctx.obj

    // 1. Novas strings em .rodata (ordem identica a de registro no ModuloSSA)
    para (var i: inteiro = ctx.nStringsSinc; i < modulo.stringsBytes.tamanho(); i++) {
        ctx.strOffsets.empilhar(obj.rodataBytes.tamanho())
        const dados: inteiro[] = modulo.stringsBytes[i]
        obj.rodataBytes.anexarVetor(dados)
        obj.rodataBytes.anexarByte(0)
    }

    ctx.nStringsSinc = modulo.stringsBytes.tamanho()

    // 2. Novas globais (.data / .bss) e relocacoes .rela.data
    const inicioGlob: inteiro = ctx.nGlobaisSinc
    para (var i: inteiro = inicioGlob; i < modulo.globais.tamanho(); i++) {
        const g: qualquer = modulo.globais[i]
        se (g.ehWeak) ctx.globaisWeak[g.nome] = verdadeiro
        se (g.temInit) {
            const padG: inteiro = elfComum.alinharValor(obj.dataBytes.tamanho(), g.alinhamento) - obj.dataBytes.tamanho()
            se (padG > 0) obj.dataBytes.anexarZeros(padG)
            const offG: inteiro = obj.dataBytes.tamanho()
            ctx.mapaGlobalSec[g.nome] = ".data"
            ctx.mapaGlobalOff[g.nome] = offG
            obj.dataBytes.anexarVetor(g.bytesInit)
            obj.simbolos.empilhar(emMod.SimboloObj(g.nome, "DATA", offG, g.tamanhoBytes,
                !g.ehStatic, elfComum.STT_OBJECT, g.ehWeak))
        } senao {
            obj.bssSize = elfComum.alinharValor(obj.bssSize, g.alinhamento)
            const offB: inteiro = obj.bssSize
            ctx.mapaGlobalSec[g.nome] = ".bss"
            ctx.mapaGlobalOff[g.nome] = offB
            obj.bssSize = obj.bssSize + g.tamanhoBytes
            obj.simbolos.empilhar(emMod.SimboloObj(g.nome, "BSS", offB, g.tamanhoBytes, !g.ehStatic,
                elfComum.STT_OBJECT, g.ehWeak))
        }
    }

    para (var i: inteiro = inicioGlob; i < modulo.globais.tamanho(); i++) {
        const g: qualquer = modulo.globais[i]
        se (!g.temInit ou g.relocs.tamanho() == 0) continua
        const baseOffG: inteiro = inteiro(ctx.mapaGlobalOff[g.nome])
        para (var r: inteiro = 0; r < g.relocs.tamanho(); r++) {
            const rel: qualquer = g.relocs[r]
            const offDataRel: inteiro = baseOffG + rel.offsetGlobal
            se (rel.ehStr) {
                obj.relocsData.empilhar(emMod.RelocObj(offDataRel, ".rodata", elfComum.R_X86_64_64,
                    ctx.strOffsets[rel.idxStr] + rel.addend))
            } senao se (ctx.mapaGlobalSec.contem(rel.simbolo)) {
                obj.relocsData.empilhar(emMod.RelocObj(offDataRel, texto(ctx.mapaGlobalSec[rel.simbolo]),
                    elfComum.R_X86_64_64, inteiro(ctx.mapaGlobalOff[rel.simbolo]) + rel.addend))
            } senao se (ctx.funcoesLocais.contem(rel.simbolo)) {
                obj.relocsData.empilhar(emMod.RelocObj(offDataRel, rel.simbolo, elfComum.R_X86_64_64,
                    rel.addend))
            } senao {
                ctx.externosExtras[rel.simbolo] = verdadeiro
                obj.relocsData.empilhar(emMod.RelocObj(offDataRel, rel.simbolo, elfComum.R_X86_64_64,
                    rel.addend))
            }
        }
        g.bytesInit = []
        g.relocs = []
    }

    ctx.nGlobaisSinc = modulo.globais.tamanho()
}

funcao iniciarCodegenStreaming(modulo: qualquer, funcoesLocais: dicionario, funcoesWeak: dicionario): ContextoCodegenStreaming {
    const ctx: ContextoCodegenStreaming = ContextoCodegenStreaming(funcoesLocais, funcoesWeak)
    para (var i: inteiro = 0; i < modulo.libsExternas.tamanho(); i++) {
        ctx.obj.libsExternas.empilhar(modulo.libsExternas[i])
    }

    sincronizarModuloStreaming(ctx, modulo)
    retorna ctx
}

funcao emitirFuncaoParaEmissor(emissor: qualquer, fn: qualquer, strOffsets: inteiro[], mapaGlobalSec: dicionario,
    mapaGlobalOff: dicionario, globaisWeak: dicionario, funcoesLocais: dicionario, funcoesWeak: dicionario,
    externosExtras: dicionario, externosTls: dicionario): (inteiro, inteiro) {
    const tMod: qualquer = importar("../../types/tipos.delegua")
    const elfComum: qualquer = importar("../../object/elf/elf_comum.delegua")
    const diagMod: qualquer = importar("../../diagnostics/diag.delegua")
    const OpI: qualquer = tMod.OpIR

    // Alocacao linear-scan O(N) de slots de pilha para registradores SSA.
    // Evita stack frames de centenas de KiB em funcoes grandes/recursivas (ex.: baixarExpr no self-hosting).
    const nRegs: inteiro = fn.numRegs > 0 ? fn.numRegs : 1
    const baseLocaisFn: inteiro = fn.tamanhoLocaisBytes
    var regOff: inteiro[] = []
    var numSlotsUsados: inteiro = fn.numRegs

    se (fn.numRegs <= 64) {
        para (var r: inteiro = 0; r < nRegs; r++) {
            regOff.empilhar(baseLocaisFn + (r + 1) * 8)
        }
    } senao {
        var defPos: inteiro[] = []
        var lastUse: inteiro[] = []
        var defBlk: inteiro[] = []
        var blockStart: inteiro[] = []
        para (var r: inteiro = 0; r < nRegs; r++) {
            defPos.empilhar(-1)
            lastUse.empilhar(-1)
            defBlk.empilhar(-1)
            regOff.empilhar(baseLocaisFn + 8)
        }
        const nBlocos: inteiro = fn.blocos.tamanho()
        var mapaBlocoIdx: dicionario = {}
        para (var b: inteiro = 0; b < nBlocos; b++) {
            mapaBlocoIdx[fn.blocos[b].nome] = b
            blockStart.empilhar(0)
        }

        const cCopy: inteiro = inteiro(OpI.Copy)
        const cAlloca: inteiro = inteiro(OpI.Alloca)
        const cLoad: inteiro = inteiro(OpI.Load)
        const cStore: inteiro = inteiro(OpI.Store)
        const cFLoad: inteiro = inteiro(OpI.FLoad)
        const cFStore: inteiro = inteiro(OpI.FStore)
        const cAdd: inteiro = inteiro(OpI.Add)
        const cUGe: inteiro = inteiro(OpI.UGe)
        const cNeg: inteiro = inteiro(OpI.Neg)
        const cBitNot: inteiro = inteiro(OpI.BitNot)
        const cFAdd: inteiro = inteiro(OpI.FAdd)
        const cFDiv: inteiro = inteiro(OpI.FDiv)
        const cFNeg: inteiro = inteiro(OpI.FNeg)
        const cFEq: inteiro = inteiro(OpI.FEq)
        const cFGe: inteiro = inteiro(OpI.FGe)
        const cItoF: inteiro = inteiro(OpI.ItoF)
        const cToBool: inteiro = inteiro(OpI.ToBool)
        const cCall: inteiro = inteiro(OpI.Call)
        const cCallIndirect: inteiro = inteiro(OpI.CallIndirect)
        const cBr: inteiro = inteiro(OpI.Br)
        const cBrCond: inteiro = inteiro(OpI.BrCond)
        const cRet: inteiro = inteiro(OpI.Ret)
        const cRetPair: inteiro = inteiro(OpI.RetPair)
        const cFRet: inteiro = inteiro(OpI.FRet)

        var backIni: inteiro[] = []
        var backFim: inteiro[] = []
        var posInst: inteiro = 0

        para (var b: inteiro = 0; b < nBlocos; b++) {
            const bb: qualquer = fn.blocos[b]
            blockStart[b] = posInst
            const nInstsB: inteiro = bb.insts.tamanho()
            para (var i: inteiro = 0; i < nInstsB; i++) {
                const inst: qualquer = bb.insts[i]
                const opI: inteiro = inteiro(inst.op)

                // Usos primeiro (garante que uso antes de def no mesmo bloco marque cross-block)
                se (opI == cStore ou opI == cFStore ou opI == cRetPair ou (opI >= cAdd e opI <= cUGe) ou (opI >= cFAdd e opI <= cFDiv) ou (opI >= cFEq e opI <= cFGe)) {
                    const ra1: inteiro = inst.a
                    se (ra1 >= 0 e ra1 < nRegs) {
                        se (defPos[ra1] < 0) {
                            defPos[ra1] = 0
                            defBlk[ra1] = -2
                        } senao se (defBlk[ra1] != b) {
                            defBlk[ra1] = -2
                        }
                        se (lastUse[ra1] < posInst) lastUse[ra1] = posInst
                    }
                    const rb1: inteiro = inst.b
                    se (rb1 >= 0 e rb1 < nRegs) {
                        se (defPos[rb1] < 0) {
                            defPos[rb1] = 0
                            defBlk[rb1] = -2
                        } senao se (defBlk[rb1] != b) {
                            defBlk[rb1] = -2
                        }
                        se (lastUse[rb1] < posInst) lastUse[rb1] = posInst
                    }
                } senao se (opI == cLoad ou opI == cFLoad ou opI == cAlloca ou opI == cCopy ou opI == cBrCond ou opI == cRet ou opI == cFRet ou (opI >= cNeg e opI <= cBitNot) ou opI == cFNeg ou (opI >= cItoF e opI <= cToBool)) {
                    const ra2: inteiro = inst.a
                    se (ra2 >= 0 e ra2 < nRegs) {
                        se (defPos[ra2] < 0) {
                            defPos[ra2] = 0
                            defBlk[ra2] = -2
                        } senao se (defBlk[ra2] != b) {
                            defBlk[ra2] = -2
                        }
                        se (lastUse[ra2] < posInst) lastUse[ra2] = posInst
                    }
                } senao se (opI >= cCall e opI <= cCallIndirect) {
                    const ci: qualquer = inst.callInfo
                    se (opI == cCallIndirect) {
                        const raC: inteiro = inst.a
                        se (raC >= 0 e raC < nRegs) {
                            se (defPos[raC] < 0) {
                                defPos[raC] = 0
                                defBlk[raC] = -2
                            } senao se (defBlk[raC] != b) {
                                defBlk[raC] = -2
                            }
                            se (lastUse[raC] < posInst) lastUse[raC] = posInst
                        }
                    }
                    const srC: inteiro = ci.sretReg
                    se (srC >= 0 e srC < nRegs) {
                        se (defPos[srC] < 0) {
                            defPos[srC] = 0
                            defBlk[srC] = -2
                        } senao se (defBlk[srC] != b) {
                            defBlk[srC] = -2
                        }
                        se (lastUse[srC] < posInst) lastUse[srC] = posInst
                    }
                    para (var k: inteiro = 0; k < ci.args.tamanho(); k++) {
                        const raA: inteiro = ci.args[k]
                        se (raA >= 0 e raA < nRegs) {
                            se (defPos[raA] < 0) {
                                defPos[raA] = 0
                                defBlk[raA] = -2
                            } senao se (defBlk[raA] != b) {
                                defBlk[raA] = -2
                            }
                            se (lastUse[raA] < posInst) lastUse[raA] = posInst
                        }
                    }
                }

                // Definicoes
                const rd1: inteiro = inst.dst
                se (rd1 >= 0 e rd1 < nRegs) {
                    se (defPos[rd1] < 0) {
                        defPos[rd1] = posInst
                        defBlk[rd1] = b
                    } senao {
                        se (posInst < defPos[rd1]) defPos[rd1] = posInst
                        se (defBlk[rd1] != b) defBlk[rd1] = -2
                    }
                    se (lastUse[rd1] < posInst) lastUse[rd1] = posInst
                }
                const rd2: inteiro = inst.dst2
                se (rd2 >= 0 e rd2 < nRegs) {
                    se (defPos[rd2] < 0) {
                        defPos[rd2] = posInst
                        defBlk[rd2] = b
                    } senao {
                        se (posInst < defPos[rd2]) defPos[rd2] = posInst
                        se (defBlk[rd2] != b) defBlk[rd2] = -2
                    }
                    se (lastUse[rd2] < posInst) lastUse[rd2] = posInst
                }

                // Arestas de retorno (loops e gotos para tras)
                se (opI == cBr ou opI == cBrCond) {
                    se (mapaBlocoIdx.contem(inst.alvo1)) {
                        const tb1: inteiro = inteiro(mapaBlocoIdx[inst.alvo1])
                        se (tb1 <= b) {
                            backIni.empilhar(blockStart[tb1])
                            backFim.empilhar(posInst)
                        }
                    }
                    se (opI == cBrCond e mapaBlocoIdx.contem(inst.alvo2)) {
                        const tb2: inteiro = inteiro(mapaBlocoIdx[inst.alvo2])
                        se (tb2 <= b) {
                            backIni.empilhar(blockStart[tb2])
                            backFim.empilhar(posInst)
                        }
                    }
                }
                posInst++
            }
        }

        const totalPos: inteiro = posInst > 0 ? posInst : 1

        // Estende vivacidade de registradores cross-block em O(totalPos + nRegs) via componentes disjuntos de loops
        se (backIni.tamanho() > 0) {
            var loopMaxEnd: inteiro[] = []
            var enclosingStart: inteiro[] = []
            var enclosingEnd: inteiro[] = []
            para (var p: inteiro = 0; p < totalPos; p++) {
                loopMaxEnd.empilhar(-1)
                enclosingStart.empilhar(-1)
                enclosingEnd.empilhar(-1)
            }
            para (var k: inteiro = 0; k < backIni.tamanho(); k++) {
                const ls: inteiro = backIni[k]
                const le: inteiro = backFim[k]
                se (ls >= 0 e ls < totalPos e le >= ls e le < totalPos) {
                    se (le > loopMaxEnd[ls]) loopMaxEnd[ls] = le
                }
            }
            var curS: inteiro = -1
            var curE: inteiro = -1
            para (var p: inteiro = 0; p < totalPos; p++) {
                const eP: inteiro = loopMaxEnd[p]
                se (eP >= 0) {
                    se (curS < 0) {
                        curS = p
                        curE = eP
                    } senao se (p <= curE) {
                        se (eP > curE) curE = eP
                    } senao {
                        para (var q: inteiro = curS; q <= curE; q++) {
                            enclosingStart[q] = curS
                            enclosingEnd[q] = curE
                        }
                        curS = p
                        curE = eP
                    }
                }
            }
            se (curS >= 0) {
                para (var q: inteiro = curS; q <= curE; q++) {
                    enclosingStart[q] = curS
                    enclosingEnd[q] = curE
                }
            }
            para (var r: inteiro = 0; r < fn.numRegs; r++) {
                se (defBlk[r] != -2) continua
                var dp: inteiro = defPos[r]
                se (dp < 0) continua
                var lu: inteiro = lastUse[r]
                se (lu >= 0 e lu < totalPos) {
                    const es1: inteiro = enclosingStart[lu]
                    se (es1 >= 0) {
                        const ee1: inteiro = enclosingEnd[lu]
                        se (lu < ee1) lu = ee1
                        se (dp >= es1 e dp > es1) dp = es1
                    }
                }
                se (dp < totalPos) {
                    const es2: inteiro = enclosingStart[dp]
                    se (es2 >= 0) {
                        const ee2: inteiro = enclosingEnd[dp]
                        se (dp > es2) dp = es2
                        se (lu < ee2) lu = ee2
                    }
                }
                defPos[r] = dp
                lastUse[r] = lu
            }
        }

        // Varredura linear O(totalPos + nRegs) para atribuir offsets finais de pilha em regOff
        var defHead: inteiro[] = []
        var expHead: inteiro[] = []
        para (var p: inteiro = 0; p <= totalPos; p++) {
            defHead.empilhar(-1)
            expHead.empilhar(-1)
        }
        var defNext: inteiro[] = []
        var expNext: inteiro[] = []
        para (var r: inteiro = 0; r < nRegs; r++) {
            defNext.empilhar(-1)
            expNext.empilhar(-1)
        }

        para (var r: inteiro = fn.numRegs - 1; r >= 0; r--) {
            const dp: inteiro = defPos[r]
            se (dp >= 0 e dp <= totalPos) {
                defNext[r] = defHead[dp]
                defHead[dp] = r
            }
        }

        var livresSlots: inteiro[] = []
        numSlotsUsados = 0

        para (var pPos: inteiro = 0; pPos < totalPos; pPos++) {
            se (pPos > 0) {
                var expR: inteiro = expHead[pPos - 1]
                enquanto (expR >= 0) {
                    livresSlots.empilhar(regOff[expR])
                    expR = expNext[expR]
                }
            }
            var curR: inteiro = defHead[pPos]
            enquanto (curR >= 0) {
                var offSlot: inteiro = 0
                se (livresSlots.tamanho() > 0) {
                    offSlot = livresSlots.removerUltimo()
                } senao {
                    numSlotsUsados++
                    offSlot = baseLocaisFn + numSlotsUsados * 8
                }
                regOff[curR] = offSlot
                var lu: inteiro = lastUse[curR]
                se (lu < pPos) lu = pPos
                se (lu > totalPos) lu = totalPos
                expNext[curR] = expHead[lu]
                expHead[lu] = curR
                curR = defNext[curR]
            }
        }
    }

    enquanto (emissor.code.tamanho() % 16 != 0) emissor.u8(144) // nop alinhamento 16B
    const inicioFn: inteiro = emissor.code.tamanho()
    const inicioPatches: inteiro = emissor.patchesRel32.tamanho()
    const frameBytes: inteiro = elfComum.alinharValor(fn.tamanhoLocaisBytes + numSlotsUsados * 8,
        16)
    se (frameBytes > 1073741824) {
        falhar diagMod.ErroDCC("Backend x86-64: stack frame excessivo (${frameBytes} bytes) na funcao '${fn.nome}'",
            "", 0, 0, "E4001", falso)
    }

    emissor.marcarLabel("fn_" + fn.nome)
    emissor.pushRbp()
    emissor.movRbpRsp()
    se (frameBytes > 0) emissor.subRspImm32(frameBytes)

    se (fn.ehVariadica) {
        para (var r: inteiro = 0; r < 6; r++) {
            emissor.storeArgAbiRbp(r, fn.regSaveOffset - r * 8)
        }
        para (var x: inteiro = 0; x < 8; x++) {
            emissor.storeXmmRbpDisp(x, -(fn.regSaveOffset - (48 + x * 16)))
        }
    }

    var pInt: inteiro = 0
    var pFlt: inteiro = 0
    var pStk: inteiro = 0

    // Se funcao retorna struct > 16B, salva ponteiro oculto sret (rdi)
    se (fn.retStructModo == 3) {
        emissor.storeArgAbiRbp(0, fn.sretPtrOffset)
        pInt = 1
    }

    para (var p: inteiro = 0; p < fn.aridade; p++) {
        const offP: inteiro = fn.paramOffsets[p]
        const largP: inteiro = fn.paramLarguras[p]
        const ehFltP: logico = fn.paramEhFloat[p]
        const ehStructP: logico = p < fn.paramEhStruct.tamanho() ? fn.paramEhStruct[p] : falso

        se (ehStructP) {
            se (largP <= 8) {
                se (pInt < 6) {
                    emissor.storeArgAbiRbp(pInt, offP)
                    pInt++
                } senao {
                    emissor.loadRaxRbpDisp(16 + pStk * 8)
                    emissor.storeRaxRbp(offP)
                    pStk++
                }
            } senao se (largP <= 16) {
                se (pInt + 2 <= 6) {
                    emissor.storeArgAbiRbp(pInt, offP)
                    emissor.storeArgAbiRbp(pInt + 1, offP - 8)
                    pInt = pInt + 2
                } senao {
                    emissor.loadRaxRbpDisp(16 + pStk * 8)
                    emissor.storeRaxRbp(offP)
                    emissor.loadRaxRbpDisp(16 + (pStk + 1) * 8)
                    emissor.storeRaxRbp(offP - 8)
                    pStk = pStk + 2
                }
            } senao {
                const nQ: inteiro = (largP + 7) \ 8
                para (var q: inteiro = 0; q < nQ; q++) {
                    emissor.loadRaxRbpDisp(16 + (pStk + q) * 8)
                    emissor.storeRaxRbpDisp(-offP + q * 8)
                }
                pStk = pStk + nQ
            }
            continua
        }

        se (ehFltP) {
            se (pFlt < 8) {
                se (largP == 4) {
                    emissor.storeXmmFloatRbpDisp(pFlt, -offP)
                } senao {
                    emissor.storeXmmRbpDisp(pFlt, -offP)
                }
                pFlt++
            } senao {
                const stkOff: inteiro = 16 + pStk * 8
                se (largP == 4) {
                    emissor.loadXmmFloatRbpDisp(0, stkOff)
                    emissor.storeXmmFloatRbpDisp(0, -offP)
                } senao {
                    emissor.loadXmmRbpDisp(0, stkOff)
                    emissor.storeXmmRbpDisp(0, -offP)
                }
                pStk++
            }
        } senao {
            se (pInt < 6) {
                emissor.storeArgAbiRbp(pInt, offP)
                pInt++
            } senao {
                const stkOff: inteiro = 16 + pStk * 8
                emissor.loadRaxRbpDisp(stkOff)
                emissor.storeRaxRbp(offP)
                pStk++
            }
        }
    }

    para (var b: inteiro = 0; b < fn.blocos.tamanho(); b++) {
        const bb: qualquer = fn.blocos[b]
        emissor.marcarLabel("bb_" + fn.nome + "_" + bb.nome)
        var regEmRax: inteiro = -1

        para (var i: inteiro = 0; i < bb.insts.tamanho(); i++) {
            const inst: qualquer = bb.insts[i]
            const op: qualquer = inst.op

            escolha (op) {
                caso OpI.Const:
                emissor.movRaxImm64(inst.a)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.FConst:
                const fBits: inteiro = inst.b != 0 ? inst.a : tMod.doubleParaBitsIEEE754(inst.fval)
                emissor.movRaxImm64(fBits)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.Copy:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.AddrSlot:
                emissor.leaRaxRbp(inst.a)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.AddrRbpDisp:
                emissor.leaRaxRbpDisp(inst.a)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.AddrGlobal:
                se (globaisWeak.contem(inst.alvo1)) {
                    emissor.leaRaxRipReloc(inst.alvo1, -4)
                } senao {
                    const secG: texto = texto(mapaGlobalSec[inst.alvo1])
                    const offG: inteiro = inteiro(mapaGlobalOff[inst.alvo1])
                    emissor.leaRaxRipReloc(secG, offG - 4)
                }
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.AddrExternGlobal:
                emissor.movRaxGotReloc(inst.alvo1)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.AddrExternTls:
                externosTls[inst.alvo1] = verdadeiro
                emissor.movRaxTlsGotReloc(inst.alvo1)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.AddrFunc:
                se (funcoesWeak.contem(inst.alvo1)) {
                    emissor.leaRaxRipReloc(inst.alvo1, -4)
                } senao se (funcoesLocais.contem(inst.alvo1)) {
                    emissor.leaRaxRipLabel("fn_" + inst.alvo1)
                } senao {
                    externosExtras[inst.alvo1] = verdadeiro
                    emissor.movRaxGotReloc(inst.alvo1)
                }
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.AddrStr:
                emissor.leaRaxRipReloc(".rodata", strOffsets[inst.a] - 4)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.Alloca:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.u8(72)
                emissor.u8(131)
                emissor.u8(192)
                emissor.u8(15)
                emissor.u8(72)
                emissor.u8(131)
                emissor.u8(224)
                emissor.u8(240)
                emissor.u8(72)
                emissor.u8(41)
                emissor.u8(196)
                emissor.u8(72)
                emissor.u8(137)
                emissor.u8(224)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.Load:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.loadSizedFromPtrRax(inst.largura, inst.ehSemSinal)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.Store:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.loadRcxRbp(regOff[inst.b])
                emissor.storeSizedRcxToPtrRax(inst.largura)
                regEmRax = -1
                caso OpI.FLoad:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.floadFromPtrRax(inst.largura)
                emissor.storeXmmRbpDisp(0, -regOff[inst.dst])
                regEmRax = -1
                caso OpI.FStore:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.loadXmmRbpDisp(0, -regOff[inst.b])
                emissor.fstoreToPtrRax(inst.largura)
                regEmRax = -1
                caso OpI.Neg:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                se (inst.largura != 4) emissor.u8(72)
                emissor.u8(247)
                emissor.u8(216)
                se (inst.largura == 4 e !inst.ehSemSinal) emissor.truncRax(4, falso)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.BitNot:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                se (inst.largura != 4) emissor.u8(72)
                emissor.u8(247)
                emissor.u8(208)
                se (inst.largura == 4 e !inst.ehSemSinal) emissor.truncRax(4, falso)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.LogNot:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.testRaxRax()
                emissor.u8(15)
                emissor.u8(148)
                emissor.u8(192)
                emissor.movzxRaxAl()
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.ToBool:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.testRaxRax()
                emissor.u8(15)
                emissor.u8(149)
                emissor.u8(192)
                emissor.movzxRaxAl()
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.TruncSext:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.truncRax(inst.largura, falso)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.TruncZext:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.truncRax(inst.largura, verdadeiro)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.ItoF:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.u8(242)
                emissor.u8(72)
                emissor.u8(15)
                emissor.u8(42)
                emissor.u8(192)
                emissor.storeXmmRbpDisp(0, -regOff[inst.dst])
                regEmRax = -1
                caso OpI.UItoF:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.emitirUItoF()
                emissor.storeXmmRbpDisp(0, -regOff[inst.dst])
                regEmRax = -1
                caso OpI.FtoI:
                emissor.loadXmmRbpDisp(0, -regOff[inst.a])
                emissor.u8(242)
                emissor.u8(72)
                emissor.u8(15)
                emissor.u8(44)
                emissor.u8(192)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.FtoUI:
                emissor.loadXmmRbpDisp(0, -regOff[inst.a])
                emissor.emitirFtoUI()
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.FNeg:
                emissor.loadXmmRbpDisp(0, -regOff[inst.a])
                emissor.movRaxImm64(-9223372036854775807 - 1)
                emissor.u8(102)
                emissor.u8(72)
                emissor.u8(15)
                emissor.u8(110)
                emissor.u8(200)
                emissor.u8(102)
                emissor.u8(15)
                emissor.u8(87)
                emissor.u8(193)
                emissor.storeXmmRbpDisp(0, -regOff[inst.dst])
                regEmRax = -1
                caso OpI.FAdd:
                caso OpI.FSub:
                caso OpI.FMul:
                caso OpI.FDiv:
                emissor.loadXmmRbpDisp(0, -regOff[inst.a])
                emissor.loadXmmRbpDisp(1, -regOff[inst.b])
                emissor.u8(242)
                emissor.u8(15)
                se (op == OpI.FAdd) emissor.u8(88)
                senao se (op == OpI.FSub) emissor.u8(92)
                senao se (op == OpI.FMul) emissor.u8(89)
                senao emissor.u8(94)
                emissor.u8(193)
                emissor.storeXmmRbpDisp(0, -regOff[inst.dst])
                regEmRax = -1
                caso OpI.FEq:
                caso OpI.FNeq:
                caso OpI.FLt:
                caso OpI.FLe:
                caso OpI.FGt:
                caso OpI.FGe:
                emissor.loadXmmRbpDisp(0, -regOff[inst.a])
                emissor.loadXmmRbpDisp(1, -regOff[inst.b])
                emissor.emitirCompFloat(op, OpI)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
                caso OpI.Br:
                emissor.jmpLabel("bb_" + fn.nome + "_" + inst.alvo1)
                regEmRax = -1
                caso OpI.BrCond:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.testRaxRax()
                emissor.jzLabel("bb_" + fn.nome + "_" + inst.alvo2)
                emissor.jmpLabel("bb_" + fn.nome + "_" + inst.alvo1)
                regEmRax = -1
                caso OpI.Ret:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.movRspRbp()
                emissor.popRbp()
                emissor.retInst()
                regEmRax = -1
                caso OpI.RetPair:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.loadRdxRbp(regOff[inst.b])
                emissor.movRspRbp()
                emissor.popRbp()
                emissor.retInst()
                regEmRax = -1
                caso OpI.FRet:
                se (inst.largura == 4) {
                    emissor.cvtsd2ssXmmFromRbpDisp(0, -regOff[inst.a])
                } senao {
                    emissor.loadXmmRbpDisp(0, -regOff[inst.a])
                }
                emissor.movRspRbp()
                emissor.popRbp()
                emissor.retInst()
                regEmRax = -1
                caso OpI.Call:
                emitirCallObj(emissor, fn, inst, funcoesWeak.contem(inst.alvo1), falso, regOff)
                regEmRax = (inst.dst >= 0 e !inst.ehFloatDst) ? inst.dst : -1
                caso OpI.CallExtern:
                emitirCallObj(emissor, fn, inst, verdadeiro, falso, regOff)
                regEmRax = (inst.dst >= 0 e !inst.ehFloatDst) ? inst.dst : -1
                caso OpI.CallIndirect:
                emitirCallObj(emissor, fn, inst, falso, verdadeiro, regOff)
                regEmRax = (inst.dst >= 0 e !inst.ehFloatDst) ? inst.dst : -1
                padrao:
                se (regEmRax != inst.a) emissor.loadRaxRbp(regOff[inst.a])
                emissor.loadRcxRbp(regOff[inst.b])
                emissor.emitirBinariaInt(op, OpI, inst.largura, inst.ehSemSinal)
                emissor.storeRaxRbp(regOff[inst.dst])
                regEmRax = inst.dst
            }
        }
    }

    emissor.resolverPatchesFuncao(inicioPatches)
    const tamFn: inteiro = emissor.code.tamanho() - inicioFn
    retorna tupla([inicioFn, tamFn])
}

funcao emitirFuncaoStreaming(ctx: ContextoCodegenStreaming, fn: qualquer): vazio {
    const emMod: qualquer = importar("emissor.delegua")
    const elfComum: qualquer = importar("../../object/elf/elf_comum.delegua")
    const span: (inteiro, inteiro) = emitirFuncaoParaEmissor(ctx.emissor, fn, ctx.strOffsets,
        ctx.mapaGlobalSec, ctx.mapaGlobalOff, ctx.globaisWeak, ctx.funcoesLocais, ctx.funcoesWeak,
        ctx.externosExtras, ctx.externosTls)
    ctx.simbolosFuncoes.empilhar(emMod.SimboloObj(fn.nome, "TEXT", span[0], span[1], !fn.ehStatic,
        elfComum.STT_FUNC, fn.ehWeak))
    fn.blocos = []
}

funcao finalizarCodegenStreaming(ctx: ContextoCodegenStreaming, modulo: qualquer): qualquer {
    const emMod: qualquer = importar("emissor.delegua")
    const elfComum: qualquer = importar("../../object/elf/elf_comum.delegua")
    sincronizarModuloStreaming(ctx, modulo)

    const obj: qualquer = ctx.obj
    para (var i: inteiro = 0; i < ctx.simbolosFuncoes.tamanho(); i++) {
        obj.simbolos.empilhar(ctx.simbolosFuncoes[i])
    }

    ctx.simbolosFuncoes = []

    ctx.emissor.resolverPatchesInternos()
    obj.textBytes = ctx.emissor.code
    obj.relocsText = ctx.emissor.relocs

    // Registra simbolos externos indefinidos (funcoes e dados)
    var extVistos: dicionario = {}
    para (var i: inteiro = 0; i < modulo.externos.tamanho(); i++) {
        const nm: texto = modulo.externos[i]
        se (!extVistos.contem(nm)) {
            extVistos[nm] = verdadeiro
            obj.simbolos.empilhar(emMod.SimboloObj(nm, "UNDEF", 0, 0, verdadeiro, elfComum.STT_NOTYPE))
        }
    }

    para (var i: inteiro = 0; i < modulo.externosDados.tamanho(); i++) {
        const nm: texto = modulo.externosDados[i]
        se (!extVistos.contem(nm)) {
            extVistos[nm] = verdadeiro
            const tipoSymExt: inteiro = ctx.externosTls.contem(nm) ? elfComum.STT_TLS : elfComum.STT_NOTYPE
            obj.simbolos.empilhar(emMod.SimboloObj(nm, "UNDEF", 0, 0, verdadeiro, tipoSymExt))
        }
    }

    const chavesEx: texto[] = ctx.externosExtras.chaves()
    para (var i: inteiro = 0; i < chavesEx.tamanho(); i++) {
        const nm: texto = chavesEx[i]
        se (!extVistos.contem(nm)) {
            extVistos[nm] = verdadeiro
            obj.simbolos.empilhar(emMod.SimboloObj(nm, "UNDEF", 0, 0, verdadeiro, elfComum.STT_NOTYPE))
        }
    }

    retorna obj
}

funcao gerarCodigoObjetoX86_64(modulo: qualquer): qualquer {
    var funcoesLocais: dicionario = {}
    var funcoesWeak: dicionario = {}
    para (var f: inteiro = 0; f < modulo.funcoes.tamanho(); f++) {
        funcoesLocais[modulo.funcoes[f].nome] = verdadeiro
        se (modulo.funcoes[f].ehWeak) funcoesWeak[modulo.funcoes[f].nome] = verdadeiro
    }

    const ctx: ContextoCodegenStreaming = iniciarCodegenStreaming(modulo, funcoesLocais,
        funcoesWeak)
    para (var f: inteiro = 0; f < modulo.funcoes.tamanho(); f++) {
        emitirFuncaoStreaming(ctx, modulo.funcoes[f])
    }

    retorna finalizarCodegenStreaming(ctx, modulo)
}
