// Emissor de arquivo objeto relocavel ELF64 padrao (ET_REL, .o) para x86-64 Linux.
// Emite 11 secoes padrao incluindo .rela.text e .rela.data (ponteiros globais inicializados),
// STB_LOCAL/STB_GLOBAL/STB_WEAK e .note.GNU-stack. Compativel com DCC linker, GNU ld, GCC e Clang.

funcao mapearSecaoShndx(sec: texto): inteiro {
    se (sec == "TEXT") retorna 1
    se (sec == "RODATA") retorna 3
    se (sec == "DATA") retorna 4
    se (sec == "BSS") retorna 6
    retorna 0 // SHN_UNDEF
}

funcao emitirObjetoELF64Bytes(obj: qualquer): qualquer {
    const bytesMod: qualquer = importar("cgd:bytes")
    const ec: qualquer = importar("elf_comum.delegua")

    // 1. Constroi .strtab e .symtab (regra ELF: todos STB_LOCAL antes de STB_GLOBAL/STB_WEAK)
    var strtab: inteiro[] = [0]
    var symtab: inteiro[] = []
    var symIdxMap: dicionario = {}

    // Entrada 0: simbolo nulo
    ec.anexarSym64(symtab, 0, 0, 0, 0, 0)
    var symCount: inteiro = 1

    // Entradas 1..4: simbolos de secao locais (.text=1, .rodata=3, .data=4, .bss=6)
    symIdxMap[".text"] = symCount
    ec.anexarSym64(symtab, 0, ec.STT_SECTION, 1, 0, 0)
    symCount++
    symIdxMap[".rodata"] = symCount
    ec.anexarSym64(symtab, 0, ec.STT_SECTION, 3, 0, 0)
    symCount++
    symIdxMap[".data"] = symCount
    ec.anexarSym64(symtab, 0, ec.STT_SECTION, 4, 0, 0)
    symCount++
    symIdxMap[".bss"] = symCount
    ec.anexarSym64(symtab, 0, ec.STT_SECTION, 6, 0, 0)
    symCount++

    // Demais simbolos STB_LOCAL
    para (var i: inteiro = 0; i < obj.simbolos.tamanho(); i++) {
        const s: qualquer = obj.simbolos[i]
        se (s.ehGlobal) continua
        const nameOff: inteiro = ec.anexarCString(strtab, s.nome, bytesMod)
        symIdxMap[s.nome] = symCount
        ec.anexarSym64(symtab, nameOff, s.tipoSym & 15, mapearSecaoShndx(s.secao), s.offset,
            s.tamanho)
        symCount++
    }

    const firstGlobalIdx: inteiro = symCount

    // Simbolos STB_GLOBAL / STB_WEAK (definidos e SHN_UNDEF)
    para (var i: inteiro = 0; i < obj.simbolos.tamanho(); i++) {
        const s: qualquer = obj.simbolos[i]
        se (!s.ehGlobal) continua
        const nameOff: inteiro = ec.anexarCString(strtab, s.nome, bytesMod)
        symIdxMap[s.nome] = symCount
        const bindVal: inteiro = s.ehWeak ? ec.STB_WEAK : ec.STB_GLOBAL
        const bindBits: inteiro = bindVal << 4
        ec.anexarSym64(symtab, nameOff, bindBits | (s.tipoSym & 15), mapearSecaoShndx(s.secao),
            s.offset, s.tamanho)
        symCount++
    }

    // 2. Constroi .rela.text e .rela.data diretamente em cgd:bytes (1 byte/byte)
    const relaText: qualquer = bytesMod.Bytes.criarReservado(obj.relocsText.tamanho() * 24)
    para (var i: inteiro = 0; i < obj.relocsText.tamanho(); i++) {
        const r: qualquer = obj.relocsText[i]
        const sIdx: inteiro = inteiro(symIdxMap[r.simbolo])
        const infoR: inteiro = (sIdx << 32) | (r.tipoReloc & 4294967295)
        relaText.anexarU64LE(r.offset)
        relaText.anexarU64LE(infoR)
        relaText.anexarU64LE(r.addend)
    }

    const relaData: qualquer = bytesMod.Bytes.criarReservado(obj.relocsData.tamanho() * 24)
    para (var i: inteiro = 0; i < obj.relocsData.tamanho(); i++) {
        const r: qualquer = obj.relocsData[i]
        const sIdx: inteiro = inteiro(symIdxMap[r.simbolo])
        const infoR: inteiro = (sIdx << 32) | (r.tipoReloc & 4294967295)
        relaData.anexarU64LE(r.offset)
        relaData.anexarU64LE(infoR)
        relaData.anexarU64LE(r.addend)
    }

    // 3. Constroi .shstrtab
    var shstrtab: inteiro[] = [0]
    const nText: inteiro = ec.anexarCString(shstrtab, ".text", bytesMod)
    const nRelaText: inteiro = ec.anexarCString(shstrtab, ".rela.text", bytesMod)
    const nRodata: inteiro = ec.anexarCString(shstrtab, ".rodata", bytesMod)
    const nData: inteiro = ec.anexarCString(shstrtab, ".data", bytesMod)
    const nRelaData: inteiro = ec.anexarCString(shstrtab, ".rela.data", bytesMod)
    const nBss: inteiro = ec.anexarCString(shstrtab, ".bss", bytesMod)
    const nSymtab: inteiro = ec.anexarCString(shstrtab, ".symtab", bytesMod)
    const nStrtab: inteiro = ec.anexarCString(shstrtab, ".strtab", bytesMod)
    const nShstrtab: inteiro = ec.anexarCString(shstrtab, ".shstrtab", bytesMod)
    const nGnuStack: inteiro = ec.anexarCString(shstrtab, ".note.GNU-stack", bytesMod)

    // 4. Calcula offsets exatos sem duplicar secoes em vetores inteiro[] gigantes
    const lenText: inteiro = obj.textBytes.tamanho()
    const offText: inteiro = 64
    const offRodata: inteiro = ec.alinharValor(offText + lenText, 8)
    const padRodata: inteiro = offRodata - (offText + lenText)
    const lenRodata: inteiro = obj.rodataBytes.tamanho()

    const offData: inteiro = ec.alinharValor(offRodata + lenRodata, 8)
    const padData: inteiro = offData - (offRodata + lenRodata)
    const lenData: inteiro = obj.dataBytes.tamanho()

    const offBss: inteiro = ec.alinharValor(offData + lenData, 8)
    const offRelaText: inteiro = offBss
    const padRelaText: inteiro = offRelaText - (offData + lenData)
    const lenRelaText: inteiro = relaText.tamanho()

    const offRelaData: inteiro = ec.alinharValor(offRelaText + lenRelaText, 8)
    const padRelaData: inteiro = offRelaData - (offRelaText + lenRelaText)
    const lenRelaData: inteiro = relaData.tamanho()

    const offSymtab: inteiro = ec.alinharValor(offRelaData + lenRelaData, 8)
    const padSymtab: inteiro = offSymtab - (offRelaData + lenRelaData)
    const lenSymtab: inteiro = symtab.tamanho()

    const offStrtab: inteiro = offSymtab + lenSymtab
    const lenStrtab: inteiro = strtab.tamanho()

    const offShstrtab: inteiro = offStrtab + lenStrtab
    const lenShstrtab: inteiro = shstrtab.tamanho()

    const offShdrs: inteiro = ec.alinharValor(offShstrtab + lenShstrtab, 8)
    const padShdrs: inteiro = offShdrs - (offShstrtab + lenShstrtab)
    const numShdrs: inteiro = 11

    // 5. ELF64 Header (64 bytes)
    var hdr: inteiro[] = [
        ec.ELF_MAGIC_0, ec.ELF_MAGIC_1, ec.ELF_MAGIC_2, ec.ELF_MAGIC_3,
        ec.ELFCLASS64, ec.ELFDATA2LSB, ec.EV_CURRENT, 0,
        0, 0, 0, 0, 0, 0, 0, 0
    ]
    ec.anexarU16(hdr, ec.ET_REL)
    ec.anexarU16(hdr, ec.EM_X86_64)
    ec.anexarU32(hdr, ec.EV_CURRENT)
    ec.anexarU64(hdr, 0)
    ec.anexarU64(hdr, 0)
    ec.anexarU64(hdr, offShdrs)
    ec.anexarU32(hdr, 0)
    ec.anexarU16(hdr, 64)
    ec.anexarU16(hdr, 0)
    ec.anexarU16(hdr, 0)
    ec.anexarU16(hdr, 64)
    ec.anexarU16(hdr, numShdrs)
    ec.anexarU16(hdr, 9) // e_shstrndx = 9 (.shstrtab)

    // 6. 11 Section Headers (704 bytes)
    var shdrs: inteiro[] = []
    ec.anexarShdr(shdrs, 0, ec.SHT_NULL, 0, 0, 0, 0, 0, 0, 0, 0)
    ec.anexarShdr(shdrs, nText, ec.SHT_PROGBITS, ec.SHF_ALLOC | ec.SHF_EXECINSTR, 0, offText,
        lenText, 0, 0, 16, 0)
    ec.anexarShdr(shdrs, nRelaText, ec.SHT_RELA, ec.SHF_INFO_LINK, 0, offRelaText, lenRelaText,
        7, 1, 8, 24)
    ec.anexarShdr(shdrs, nRodata, ec.SHT_PROGBITS, ec.SHF_ALLOC, 0, offRodata, lenRodata,
        0, 0, 8, 0)
    ec.anexarShdr(shdrs, nData, ec.SHT_PROGBITS, ec.SHF_ALLOC | ec.SHF_WRITE, 0, offData,
        lenData, 0, 0, 8, 0)
    ec.anexarShdr(shdrs, nRelaData, ec.SHT_RELA, ec.SHF_INFO_LINK, 0, offRelaData, lenRelaData,
        7, 4, 8, 24)
    ec.anexarShdr(shdrs, nBss, ec.SHT_NOBITS, ec.SHF_ALLOC | ec.SHF_WRITE, 0, offBss, obj.bssSize,
        0, 0, 8, 0)
    ec.anexarShdr(shdrs, nSymtab, ec.SHT_SYMTAB, 0, 0, offSymtab, lenSymtab, 8, firstGlobalIdx,
        8, 24)
    ec.anexarShdr(shdrs, nStrtab, ec.SHT_STRTAB, 0, 0, offStrtab, lenStrtab, 0, 0, 1, 0)
    ec.anexarShdr(shdrs, nShstrtab, ec.SHT_STRTAB, 0, 0, offShstrtab, lenShstrtab, 0, 0,
        1, 0)
    ec.anexarShdr(shdrs, nGnuStack, ec.SHT_PROGBITS, 0, 0, offShdrs, 0, 0, 0, 1, 0)

    // 7. Monta buffer nativo cgd:bytes com reserva exata em uma unica alocacao (sem copias repetidas)
    const tamTotal: inteiro = offShdrs + shdrs.tamanho()
    const out: qualquer = bytesMod.Bytes.criarReservado(tamTotal)
    out.anexarVetor(hdr)
    se (lenText > 0) out.anexarBytes(obj.textBytes)
    se (padRodata > 0) out.anexarZeros(padRodata)
    se (lenRodata > 0) out.anexarBytes(obj.rodataBytes)
    se (padData > 0) out.anexarZeros(padData)
    se (lenData > 0) out.anexarBytes(obj.dataBytes)
    se (padRelaText > 0) out.anexarZeros(padRelaText)
    se (lenRelaText > 0) out.anexarBytes(relaText)
    se (padRelaData > 0) out.anexarZeros(padRelaData)
    se (lenRelaData > 0) out.anexarBytes(relaData)
    se (padSymtab > 0) out.anexarZeros(padSymtab)
    se (lenSymtab > 0) out.anexarVetor(symtab)
    se (lenStrtab > 0) out.anexarVetor(strtab)
    se (lenShstrtab > 0) out.anexarVetor(shstrtab)
    se (padShdrs > 0) out.anexarZeros(padShdrs)
    out.anexarVetor(shdrs)
    retorna out
}

funcao emitirObjetoELF64(obj: qualquer): inteiro[] {
    retorna emitirObjetoELF64Bytes(obj).paraVetor()
}
