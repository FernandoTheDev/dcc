// Emissor de arquivo objeto relocavel ELF64 padrao (ET_REL, .o) para x86-64 Linux.
// Emite 11 secoes padrao incluindo .rela.text e .rela.data (ponteiros globais inicializados),
// STB_LOCAL/STB_GLOBAL/STB_WEAK e .note.GNU-stack. Compativel com DCC linker, GNU ld, GCC e Clang.

funcao mapearSecaoShndx(sec: texto): inteiro {
    se (sec == "TEXT") retorna 1
    se (sec == "RODATA") retorna 3
    se (sec == "DATA") retorna 4
    se (sec == "BSS") retorna 6
    retorna 0 // SHN_UNDEF
}

funcao emitirObjetoELF64(obj: qualquer): inteiro[] {
    const bytesMod: qualquer = importar("cgd:bytes")
    const ec: qualquer = importar("elf_comum.delegua")

    // 1. Constroi .strtab e .symtab (regra ELF: todos STB_LOCAL antes de STB_GLOBAL/STB_WEAK)
    var strtab: inteiro[] = [0]
    var symtab: inteiro[] = []
    var symIdxMap: dicionario = {}

    // Entrada 0: simbolo nulo
    ec.anexarSym64(symtab, 0, 0, 0, 0, 0)
    var symCount: inteiro = 1

    // Entradas 1..4: simbolos de secao locais (.text=1, .rodata=3, .data=4, .bss=6)
    symIdxMap[".text"] = symCount
    ec.anexarSym64(symtab, 0, ec.STT_SECTION, 1, 0, 0)
    symCount++
    symIdxMap[".rodata"] = symCount
    ec.anexarSym64(symtab, 0, ec.STT_SECTION, 3, 0, 0)
    symCount++
    symIdxMap[".data"] = symCount
    ec.anexarSym64(symtab, 0, ec.STT_SECTION, 4, 0, 0)
    symCount++
    symIdxMap[".bss"] = symCount
    ec.anexarSym64(symtab, 0, ec.STT_SECTION, 6, 0, 0)
    symCount++

    // Demais simbolos STB_LOCAL
    para (var i: inteiro = 0; i < obj.simbolos.tamanho(); i++) {
        const s: qualquer = obj.simbolos[i]
        se (s.ehGlobal) continua
        const nameOff: inteiro = ec.anexarCString(strtab, s.nome, bytesMod)
        symIdxMap[s.nome] = symCount
        ec.anexarSym64(symtab, nameOff, s.tipoSym & 15, mapearSecaoShndx(s.secao), s.offset,
            s.tamanho)
        symCount++
    }

    const firstGlobalIdx: inteiro = symCount

    // Simbolos STB_GLOBAL / STB_WEAK (definidos e SHN_UNDEF)
    para (var i: inteiro = 0; i < obj.simbolos.tamanho(); i++) {
        const s: qualquer = obj.simbolos[i]
        se (!s.ehGlobal) continua
        const nameOff: inteiro = ec.anexarCString(strtab, s.nome, bytesMod)
        symIdxMap[s.nome] = symCount
        const bindVal: inteiro = s.ehWeak ? ec.STB_WEAK : ec.STB_GLOBAL
        const bindBits: inteiro = bindVal << 4
        ec.anexarSym64(symtab, nameOff, bindBits | (s.tipoSym & 15), mapearSecaoShndx(s.secao),
            s.offset, s.tamanho)
        symCount++
    }

    // 2. Constroi .rela.text e .rela.data
    var relaText: inteiro[] = []
    para (var i: inteiro = 0; i < obj.relocsText.tamanho(); i++) {
        const r: qualquer = obj.relocsText[i]
        const sIdx: inteiro = inteiro(symIdxMap[r.simbolo])
        ec.anexarU64(relaText, r.offset)
        ec.anexarU64(relaText, (sIdx << 32) | (r.tipoReloc & 4294967295))
        ec.anexarU64(relaText, r.addend)
    }

    var relaData: inteiro[] = []
    para (var i: inteiro = 0; i < obj.relocsData.tamanho(); i++) {
        const r: qualquer = obj.relocsData[i]
        const sIdx: inteiro = inteiro(symIdxMap[r.simbolo])
        ec.anexarU64(relaData, r.offset)
        ec.anexarU64(relaData, (sIdx << 32) | (r.tipoReloc & 4294967295))
        ec.anexarU64(relaData, r.addend)
    }

    // 3. Constroi .shstrtab
    var shstrtab: inteiro[] = [0]
    const nText: inteiro = ec.anexarCString(shstrtab, ".text", bytesMod)
    const nRelaText: inteiro = ec.anexarCString(shstrtab, ".rela.text", bytesMod)
    const nRodata: inteiro = ec.anexarCString(shstrtab, ".rodata", bytesMod)
    const nData: inteiro = ec.anexarCString(shstrtab, ".data", bytesMod)
    const nRelaData: inteiro = ec.anexarCString(shstrtab, ".rela.data", bytesMod)
    const nBss: inteiro = ec.anexarCString(shstrtab, ".bss", bytesMod)
    const nSymtab: inteiro = ec.anexarCString(shstrtab, ".symtab", bytesMod)
    const nStrtab: inteiro = ec.anexarCString(shstrtab, ".strtab", bytesMod)
    const nShstrtab: inteiro = ec.anexarCString(shstrtab, ".shstrtab", bytesMod)
    const nGnuStack: inteiro = ec.anexarCString(shstrtab, ".note.GNU-stack", bytesMod)

    // 4. Monta o corpo apos o header de 64 bytes
    var corpo: inteiro[] = []

    const offText: inteiro = 64 + corpo.tamanho()
    para (var i: inteiro = 0; i < obj.textBytes.tamanho(); i++) corpo.empilhar(obj.textBytes[i])
    const lenText: inteiro = obj.textBytes.tamanho()

    ec.preencherAlinh(corpo, 8, 0)
    const offRodata: inteiro = 64 + corpo.tamanho()
    para (var i: inteiro = 0; i < obj.rodataBytes.tamanho(); i++) corpo.empilhar(obj.rodataBytes[i])
    const lenRodata: inteiro = obj.rodataBytes.tamanho()

    ec.preencherAlinh(corpo, 8, 0)
    const offData: inteiro = 64 + corpo.tamanho()
    para (var i: inteiro = 0; i < obj.dataBytes.tamanho(); i++) corpo.empilhar(obj.dataBytes[i])
    const lenData: inteiro = obj.dataBytes.tamanho()

    ec.preencherAlinh(corpo, 8, 0)
    const offBss: inteiro = 64 + corpo.tamanho()

    ec.preencherAlinh(corpo, 8, 0)
    const offRelaText: inteiro = 64 + corpo.tamanho()
    para (var i: inteiro = 0; i < relaText.tamanho(); i++) corpo.empilhar(relaText[i])
    const lenRelaText: inteiro = relaText.tamanho()

    ec.preencherAlinh(corpo, 8, 0)
    const offRelaData: inteiro = 64 + corpo.tamanho()
    para (var i: inteiro = 0; i < relaData.tamanho(); i++) corpo.empilhar(relaData[i])
    const lenRelaData: inteiro = relaData.tamanho()

    ec.preencherAlinh(corpo, 8, 0)
    const offSymtab: inteiro = 64 + corpo.tamanho()
    para (var i: inteiro = 0; i < symtab.tamanho(); i++) corpo.empilhar(symtab[i])
    const lenSymtab: inteiro = symtab.tamanho()

    const offStrtab: inteiro = 64 + corpo.tamanho()
    para (var i: inteiro = 0; i < strtab.tamanho(); i++) corpo.empilhar(strtab[i])
    const lenStrtab: inteiro = strtab.tamanho()

    const offShstrtab: inteiro = 64 + corpo.tamanho()
    para (var i: inteiro = 0; i < shstrtab.tamanho(); i++) corpo.empilhar(shstrtab[i])
    const lenShstrtab: inteiro = shstrtab.tamanho()

    ec.preencherAlinh(corpo, 8, 0)
    const offShdrs: inteiro = 64 + corpo.tamanho()
    const numShdrs: inteiro = 11

    // 5. ELF64 Header (ET_REL, EM_X86_64)
    var elf: inteiro[] = [
        ec.ELF_MAGIC_0, ec.ELF_MAGIC_1, ec.ELF_MAGIC_2, ec.ELF_MAGIC_3,
        ec.ELFCLASS64, ec.ELFDATA2LSB, ec.EV_CURRENT, 0,
        0, 0, 0, 0, 0, 0, 0, 0
    ]
    ec.anexarU16(elf, ec.ET_REL)
    ec.anexarU16(elf, ec.EM_X86_64)
    ec.anexarU32(elf, ec.EV_CURRENT)
    ec.anexarU64(elf, 0)
    ec.anexarU64(elf, 0)
    ec.anexarU64(elf, offShdrs)
    ec.anexarU32(elf, 0)
    ec.anexarU16(elf, 64)
    ec.anexarU16(elf, 0)
    ec.anexarU16(elf, 0)
    ec.anexarU16(elf, 64)
    ec.anexarU16(elf, numShdrs)
    ec.anexarU16(elf, 9) // e_shstrndx = 9 (.shstrtab)

    para (var i: inteiro = 0; i < corpo.tamanho(); i++) elf.empilhar(corpo[i])

    // 11 Section Headers:
    // 0:NULL, 1:.text, 2:.rela.text, 3:.rodata, 4:.data, 5:.rela.data, 6:.bss, 7:.symtab, 8:.strtab, 9:.shstrtab, 10:.note.GNU-stack
    ec.anexarShdr(elf, 0, ec.SHT_NULL, 0, 0, 0, 0, 0, 0, 0, 0)
    ec.anexarShdr(elf, nText, ec.SHT_PROGBITS, ec.SHF_ALLOC | ec.SHF_EXECINSTR, 0, offText,
        lenText, 0, 0, 16, 0)
    ec.anexarShdr(elf, nRelaText, ec.SHT_RELA, ec.SHF_INFO_LINK, 0, offRelaText, lenRelaText,
        7, 1, 8, 24)
    ec.anexarShdr(elf, nRodata, ec.SHT_PROGBITS, ec.SHF_ALLOC, 0, offRodata, lenRodata, 0,
        0, 8, 0)
    ec.anexarShdr(elf, nData, ec.SHT_PROGBITS, ec.SHF_ALLOC | ec.SHF_WRITE, 0, offData, lenData,
        0, 0, 8, 0)
    ec.anexarShdr(elf, nRelaData, ec.SHT_RELA, ec.SHF_INFO_LINK, 0, offRelaData, lenRelaData,
        7, 4, 8, 24)
    ec.anexarShdr(elf, nBss, ec.SHT_NOBITS, ec.SHF_ALLOC | ec.SHF_WRITE, 0, offBss, obj.bssSize,
        0, 0, 8, 0)
    ec.anexarShdr(elf, nSymtab, ec.SHT_SYMTAB, 0, 0, offSymtab, lenSymtab, 8, firstGlobalIdx,
        8, 24)
    ec.anexarShdr(elf, nStrtab, ec.SHT_STRTAB, 0, 0, offStrtab, lenStrtab, 0, 0, 1, 0)
    ec.anexarShdr(elf, nShstrtab, ec.SHT_STRTAB, 0, 0, offShstrtab, lenShstrtab, 0, 0, 1,
        0)
    ec.anexarShdr(elf, nGnuStack, ec.SHT_PROGBITS, 0, 0, offShdrs, 0, 0, 0, 1, 0)

    retorna elf
}
