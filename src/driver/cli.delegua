// Driver CLI completo do DCC (Delegua C Compiler).
// Suporta compilacao de .c -> -E / -S / -c (.o ELF64) / executavel ELF64 via linker nativo,
// combinando arquivos .c, .o e bibliotecas estaticas .a (inclusive objetos de GCC/Clang).
// Utiliza a biblioteca padrao CGD (cgd:io, cgd:caminhos, cgd:textos, cgd:arquivos, cgd:bytes,
// cgd:processo, cgd:tempo) e envia todos os erros e avisos exclusivamente para stderr.

@definicao(biblioteca = "c", abi = "c")
classe estrangeira LibCChmod {
    @definicao(simbolo = "chmod")
    estatico chmodArq(caminho: texto, modo: inteiro): inteiro;
}

funcao escreverErro(msg: texto): vazio {
    const ioMod: qualquer = importar("cgd:io")
    ioMod.IO.erroLinha(msg)
}

funcao trocarExtensaoLocal(caminho: texto, novaExt: texto): texto {
    const camMod: qualquer = importar("cgd:caminhos")
    const baseNome: texto = camMod.Caminhos.nome(caminho)
    retorna camMod.Caminhos.semExtensao(baseNome) + novaExt
}

// Grava buffer binario cgd:bytes em disco sem interpolar caminhos em comando shell;
// aplica permissao 0755 diretamente via syscall POSIX chmod (FFI).
funcao gravarBinarioBytes(caminhoSaida: texto, b: qualquer, executavel: logico): vazio {
    const procMod: qualquer = importar("cgd:processo")
    const res: qualquer = procMod.Processo.executar("/bin/sh", [
        "-c",
        "exec base64 -d > \"$1\"",
        "_",
        caminhoSaida
    ], "", {}, 60000, 65536, b.paraBase64())
    res.exigirSucesso()
    se (executavel) {
        LibCChmod.chmodArq(caminhoSaida, 493) // 0755
    }
}

funcao gravarBinario(caminhoSaida: texto, vetorBytes: qualquer, executavel: logico): vazio {
    const bytesMod: qualquer = importar("cgd:bytes")
    gravarBinarioBytes(caminhoSaida, bytesMod.Bytes.deVetor(vetorBytes), executavel)
}

funcao lerBinario(caminho: texto): inteiro[] {
    const bytesMod: qualquer = importar("cgd:bytes")
    const procMod: qualquer = importar("cgd:processo")
    const res: qualquer = procMod.Processo.executar("base64", ["-w", "0", caminho], "", {},
        15000, 67108864)
    res.exigirSucesso()
    const b64: texto = res.saidaPadrao().aparar()
    retorna bytesMod.Bytes.deBase64(b64).paraVetor()
}

// Busca primeiro biblioteca estatica lib<nome>.a em -L; se nao achar, mapeia para .so dinamica.
funcao resolverBibliotecaCli(nomeL: texto, dirsLib: texto[]): (texto, logico) {
    const arquivos: qualquer = importar("cgd:arquivos")
    const camMod: qualquer = importar("cgd:caminhos")
    para (var i: inteiro = 0; i < dirsLib.tamanho(); i++) {
        const candA: texto = camMod.Caminhos.juntar([dirsLib[i], "lib" + nomeL + ".a"])
        se (arquivos.Arquivo(candA).existe()) retorna tupla([candA, verdadeiro])
    }

    se (nomeL == "m") retorna tupla(["libm.so.6", falso])
    se (nomeL == "c") retorna tupla(["libc.so.6", falso])
    se (nomeL == "pthread") retorna tupla(["libpthread.so.0", falso])
    se (nomeL == "dl") retorna tupla(["libdl.so.2", falso])
    se (nomeL == "rt") retorna tupla(["librt.so.1", falso])
    para (var i: inteiro = 0; i < dirsLib.tamanho(); i++) {
        const candSo: texto = camMod.Caminhos.juntar([dirsLib[i], "lib" + nomeL + ".so"])
        se (arquivos.Arquivo(candSo).existe()) retorna tupla([candSo, falso])
    }

    retorna tupla(["lib" + nomeL + ".so", falso])
}

funcao imprimirAjuda(): vazio {
    escreva("Uso: dcc [opcoes] arquivo1.c|arquivo1.o|lib.a [arquivo2...]")
    escreva("")
    escreva("DCC - Delegua C Compiler v0.2.0 (Linux x86-64 / System V AMD64 ABI)")
    escreva("")
    escreva("Opcoes:")
    escreva("  -o <arquivo>                 Define o arquivo de saida (padrao: a.out)")
    escreva("  -c                           Compila para objeto relocavel ELF64 (.o) sem linkar")
    escreva("  -S                           Emite Assembly x86-64 (Intel) sem montar")
    escreva("  -E                           Executa apenas o pre-processador C99/GNU99")
    escreva("  -I <dir>                     Adiciona diretorio de busca de headers")
    escreva("  -D <MACRO[=VAL]>             Define macro no pre-processador")
    escreva("  -U <MACRO>                   Remove definicao de macro no pre-processador")
    escreva("  -L <dir>                     Adiciona diretorio de busca de bibliotecas (.a / .so)")
    escreva("  -l <lib>                     Vincula biblioteca estatica (.a) ou dinamica (.so)")
    escreva("  -std=c99                     Modo ISO C99 (padrao)")
    escreva("  -std=gnu99                   Modo C99 com extensoes GNU delimitadas")
    escreva("  -O0, -O1, -O2, -O3           Nivel de otimizacao da IR SSA")
    escreva("  -Wall, -Wextra               Ativa avisos adicionais")
    escreva("  -Werror                      Trata avisos como erros")
    escreva("  -Wno-<categoria>             Suprime avisos da categoria especificada")
    escreva("  -fdiagnostics-color=<modo>   Cores ANSI nos diagnosticos: auto, always, never")
    escreva("  -fdiagnostics-format=<fmt>   Formato de diagnosticos: text, json")
    escreva("  -ftime-report                Exibe tempo detalhado por fase de compilacao em stderr")
    escreva("  -v                           Modo detalhado (verbose)")
    escreva("  --version                    Exibe versao e alvo")
    escreva("  --help                       Exibe esta ajuda")
}

funcao emitirAvisosDiag(diag: qualquer): vazio {
    se (diag.formatoJson) {
        se (diag.itens.tamanho() > 0) {
            escreverErro(diag.serializarItensJson())
        }
        retorna
    }

    para (var w: inteiro = 0; w < diag.avisos.tamanho(); w++) {
        escreverErro(diag.avisos[w])
    }
}

funcao executarDriverDCC(args: texto[]): inteiro {
    const diagMod: qualquer = importar("../diagnostics/diag.delegua")
    const preMod: qualquer = importar("../preprocessor/preproc.delegua")
    const lexMod: qualquer = importar("../lexer/lexer.delegua")
    const parMod: qualquer = importar("../parser/parser.delegua")
    const semMod: qualquer = importar("../semantic/sema.delegua")
    const irMod: qualquer = importar("../ir/ir_ssa.delegua")
    const asmMod: qualquer = importar("../backend/x86_64/asm.delegua")
    const cgMod: qualquer = importar("../backend/x86_64/codegen.delegua")
    const elfObjMod: qualquer = importar("../object/elf/elf_obj.delegua")
    const lnkMod: qualquer = importar("../linker/linker.delegua")
    const arquivos: qualquer = importar("cgd:arquivos")
    const texMod: qualquer = importar("cgd:textos")
    const tempoMod: qualquer = importar("cgd:tempo")

    se (args.tamanho() == 0) {
        escreverErro("dcc: error: nenhum arquivo de entrada especificado (use --help)")
        retorna 1
    }

    var entradas: texto[] = []
    var dirsInclude: texto[] = []
    var defsCli: texto[] = []
    var undefsCli: texto[] = []
    var dirsLib: texto[] = []
    var libsCli: texto[] = []
    var caminhoSaida: texto = ""
    var somentePreproc: logico = falso
    var somenteAsm: logico = falso
    var somenteObjeto: logico = falso
    var modoGnu: logico = falso
    var nivelOpt: inteiro = 1
    var wall: logico = falso
    var wextra: logico = falso
    var werror: logico = falso
    var modoCor: texto = "auto"
    var formatoJson: logico = falso
    var catsDesab: dicionario = {}
    var timeReport: logico = falso
    var verbose: logico = falso

    var i: inteiro = 0
    enquanto (i < args.tamanho()) {
        const a: texto = args[i]
        se (a == "--help" ou a == "-h") {
            imprimirAjuda()
            retorna 0
        } senao se (a == "--version") {
            escreva("dcc (Delegua C Compiler) 0.2.0")
            escreva("Target: x86_64-linux-gnu (System V AMD64 ABI)")
            escreva("Implementation: Delegua / CGD")
            retorna 0
        } senao se (a == "-o") {
            se (i + 1 >= args.tamanho()) {
                escreverErro("dcc: error: argumento ausente apos '-o'")
                retorna 1
            }
            caminhoSaida = args[i + 1]
            i = i + 2
        } senao se (a == "-I") {
            se (i + 1 >= args.tamanho()) {
                escreverErro("dcc: error: diretorio ausente apos '-I'")
                retorna 1
            }
            dirsInclude.empilhar(args[i + 1])
            i = i + 2
        } senao se (a.tamanho() > 2 e texMod.Textos.comecaCom(a, "-I")) {
            dirsInclude.empilhar(a.fatiar(2, a.tamanho()))
            i++
        } senao se (a == "-D") {
            se (i + 1 >= args.tamanho()) {
                escreverErro("dcc: error: definicao ausente apos '-D'")
                retorna 1
            }
            defsCli.empilhar(args[i + 1])
            i = i + 2
        } senao se (a.tamanho() > 2 e texMod.Textos.comecaCom(a, "-D")) {
            defsCli.empilhar(a.fatiar(2, a.tamanho()))
            i++
        } senao se (a == "-U") {
            se (i + 1 >= args.tamanho()) {
                escreverErro("dcc: error: macro ausente apos '-U'")
                retorna 1
            }
            undefsCli.empilhar(args[i + 1])
            i = i + 2
        } senao se (a.tamanho() > 2 e texMod.Textos.comecaCom(a, "-U")) {
            undefsCli.empilhar(a.fatiar(2, a.tamanho()))
            i++
        } senao se (a == "-L") {
            se (i + 1 >= args.tamanho()) {
                escreverErro("dcc: error: diretorio ausente apos '-L'")
                retorna 1
            }
            dirsLib.empilhar(args[i + 1])
            i = i + 2
        } senao se (a.tamanho() > 2 e texMod.Textos.comecaCom(a, "-L")) {
            dirsLib.empilhar(a.fatiar(2, a.tamanho()))
            i++
        } senao se (a == "-l") {
            se (i + 1 >= args.tamanho()) {
                escreverErro("dcc: error: biblioteca ausente apos '-l'")
                retorna 1
            }
            libsCli.empilhar(args[i + 1])
            i = i + 2
        } senao se (a.tamanho() > 2 e texMod.Textos.comecaCom(a, "-l")) {
            libsCli.empilhar(a.fatiar(2, a.tamanho()))
            i++
        } senao se (a == "-E") {
            somentePreproc = verdadeiro
            i++
        } senao se (a == "-S") {
            somenteAsm = verdadeiro
            i++
        } senao se (a == "-c") {
            somenteObjeto = verdadeiro
            i++
        } senao se (a == "-std=c99") {
            modoGnu = falso
            i++
        } senao se (a == "-std=gnu99") {
            modoGnu = verdadeiro
            i++
        } senao se (a == "-O0") {
            nivelOpt = 0
            i++
        } senao se (a == "-O1") {
            nivelOpt = 1
            i++
        } senao se (a == "-O2") {
            nivelOpt = 2
            i++
        } senao se (a == "-O3") {
            nivelOpt = 3
            i++
        } senao se (a == "-Wall") {
            wall = verdadeiro
            i++
        } senao se (a == "-Wextra") {
            wextra = verdadeiro
            i++
        } senao se (a == "-Werror") {
            werror = verdadeiro
            i++
        } senao se (texMod.Textos.comecaCom(a, "-Wno-") e a.tamanho() > 5) {
            catsDesab[a.fatiar(5, a.tamanho())] = verdadeiro
            i++
        } senao se (a == "-fdiagnostics-color=auto" ou a == "-fdiagnostics-color=always" ou a == "-fdiagnostics-color=never") {
            modoCor = a.fatiar(20, a.tamanho())
            i++
        } senao se (a == "-fdiagnostics-format=text") {
            formatoJson = falso
            i++
        } senao se (a == "-fdiagnostics-format=json") {
            formatoJson = verdadeiro
            i++
        } senao se (a == "-ftime-report") {
            timeReport = verdadeiro
            i++
        } senao se (a == "-v") {
            verbose = verdadeiro
            i++
        } senao se (a == "-g") {
            escreverErro("dcc: error: geracao de informacoes de depuracao DWARF (-g) ainda nao implementada")
            retorna 1
        } senao se (a.tamanho() > 0 e a[0] == "-") {
            escreverErro("dcc: error: opcao desconhecida ou nao suportada '${a}'")
            retorna 1
        } senao {
            entradas.empilhar(a)
            i++
        }
    }

    se (entradas.tamanho() == 0) {
        escreverErro("dcc: error: nenhum arquivo de entrada especificado")
        retorna 1
    }

    se ((somenteObjeto ou somenteAsm) e entradas.tamanho() > 1 e caminhoSaida.tamanho() > 0) {
        escreverErro("dcc: error: nao e possivel usar '-o' com '-c' ou '-S' e multiplos arquivos de entrada")
        retorna 1
    }

    tente {
        // Modo -E: apenas pre-processamento
        se (somentePreproc) {
            var saidasPP: texto[] = []
            para (var k: inteiro = 0; k < entradas.tamanho(); k++) {
                const arq: qualquer = arquivos.Arquivo(entradas[k])
                se (!arq.existe()) {
                    escreverErro("dcc: error: arquivo nao encontrado: '${entradas[k]}'")
                    retorna 1
                }
                const diagPP: qualquer = diagMod.ContextoDiag(wall, wextra, werror, modoCor,
                    formatoJson, catsDesab)
                const resP: (texto, inteiro) = preMod.preprocessarDCC(arq.ler(), entradas[k],
                    dirsInclude, defsCli, undefsCli, diagPP, modoGnu)
                emitirAvisosDiag(diagPP)
                saidasPP.empilhar(resP[0])
            }
            const textoPP: texto = saidasPP.juntar("\n")
            se (caminhoSaida.tamanho() > 0) arquivos.Arquivo(caminhoSaida).escrever(textoPP)
            senao escreva(textoPP)
            retorna 0
        }

        var objetosLinkar: qualquer[] = []
        var nomesObjetos: texto[] = []
        var tPre: real = 0.0
        var tLex: real = 0.0
        var tPar: real = 0.0
        var tSem: real = 0.0
        var tIr: real = 0.0
        var tOpt: real = 0.0
        var tCg: real = 0.0
        var tElf: real = 0.0
        var tLnk: real = 0.0
        const cron: qualquer = tempoMod.Cronometro()

        para (var k: inteiro = 0; k < entradas.tamanho(); k++) {
            const arqPath: texto = entradas[k]
            se (!arquivos.Arquivo(arqPath).existe()) {
                escreverErro("dcc: error: arquivo nao encontrado: '${arqPath}'")
                retorna 1
            }

            se (texMod.Textos.terminaCom(arqPath, ".o") ou texMod.Textos.terminaCom(arqPath,
                ".a")) {
                se (somenteObjeto ou somenteAsm) {
                    escreverErro("dcc: error: arquivo binario '${arqPath}' nao pode ser usado com -c ou -S")
                    retorna 1
                }
                se (verbose) escreverErro("[dcc] lendo binario ELF64/ar: ${arqPath}")
                objetosLinkar.empilhar(lerBinario(arqPath))
                nomesObjetos.empilhar(arqPath)
                continua
            }

            const diag: qualquer = diagMod.ContextoDiag(wall, wextra, werror, modoCor, formatoJson,
                catsDesab)
            se (verbose) escreverErro("[dcc] pre-processando ${arqPath} (std=${modoGnu ? "gnu99" : "c99"})")

            cron.reiniciar()
            var resPre: qualquer = preMod.preprocessarDCC(arquivos.Arquivo(arqPath).ler(),
                arqPath, dirsInclude, defsCli, undefsCli, diag, modoGnu)
            tPre = tPre + cron.milisegundos()
            se (verbose) escreverErro("[dcc] preprocess concluido em ${inteiro(tPre)}ms (includes=${resPre[1]})")

            cron.reiniciar()
            var tokens: qualquer = lexMod.tokenizarDCC(resPre[0], diag, modoGnu)
            resPre = nulo
            tLex = tLex + cron.milisegundos()
            se (verbose) escreverErro("[dcc] lex concluido em ${inteiro(tLex)}ms (tokens=${tokens.tamanho()})")

            cron.reiniciar()
            var ast: qualquer = parMod.analisarSintaxeDCC(tokens, diag, modoGnu)
            tokens = nulo
            tPar = tPar + cron.milisegundos()
            se (verbose) escreverErro("[dcc] parse concluido em ${inteiro(tPar)}ms (decls=${ast.filhos.tamanho()})")

            cron.reiniciar()
            var resSema: qualquer = semMod.analisarSemanticaDCC(ast, diag, falso)
            tSem = tSem + cron.milisegundos()
            se (verbose) escreverErro("[dcc] sema concluido em ${inteiro(tSem)}ms")

            cron.reiniciar()
            var moduloSSA: qualquer = irMod.construirModuloSSA(ast, resSema.tabela)
            ast = nulo
            resSema = nulo
            tIr = tIr + cron.milisegundos()
            se (verbose) escreverErro("[dcc] ir concluido em ${inteiro(tIr)}ms (fns=${moduloSSA.funcoes.tamanho()})")

            cron.reiniciar()
            se (nivelOpt > 0) {
                para (var p: inteiro = 0; p < nivelOpt; p++) {
                    irMod.otimizarModuloSSA(moduloSSA)
                }
            }
            irMod.verificarModuloSSA(moduloSSA)
            tOpt = tOpt + cron.milisegundos()
            se (verbose) escreverErro("[dcc] opt+verify concluido em ${inteiro(tOpt)}ms")

            emitirAvisosDiag(diag)

            se (somenteAsm) {
                cron.reiniciar()
                const codigoAsm: texto = asmMod.emitirAssemblyX86_64(moduloSSA)
                moduloSSA = nulo
                tCg = tCg + cron.milisegundos()
                const destAsm: texto = caminhoSaida.tamanho() > 0 ? caminhoSaida : trocarExtensaoLocal(arqPath,
                    ".s")
                arquivos.Arquivo(destAsm).escrever(codigoAsm)
                se (verbose) escreverErro("[dcc] assembly emitido em ${destAsm}")
                continua
            }

            cron.reiniciar()
            var codObj: qualquer = cgMod.gerarCodigoObjetoX86_64(moduloSSA)
            moduloSSA = nulo
            tCg = tCg + cron.milisegundos()
            se (verbose) escreverErro("[dcc] codegen concluido em ${inteiro(tCg)}ms (text=${codObj.textBytes.tamanho()}B)")

            se (somenteObjeto) {
                cron.reiniciar()
                const bytesObjB: qualquer = elfObjMod.emitirObjetoELF64Bytes(codObj)
                codObj = nulo
                tElf = tElf + cron.milisegundos()
                se (verbose) escreverErro("[dcc] elf_obj concluido em ${inteiro(tElf)}ms (${bytesObjB.tamanho()}B)")
                const destObj: texto = caminhoSaida.tamanho() > 0 ? caminhoSaida : trocarExtensaoLocal(arqPath,
                    ".o")
                gravarBinarioBytes(destObj, bytesObjB, falso)
                se (verbose) escreverErro("[dcc] objeto ELF64 emitido em ${destObj} (${bytesObjB.tamanho()} bytes)")
            } senao {
                cron.reiniciar()
                const bytesObj: inteiro[] = elfObjMod.emitirObjetoELF64(codObj)
                codObj = nulo
                tElf = tElf + cron.milisegundos()
                se (verbose) escreverErro("[dcc] elf_obj concluido em ${inteiro(tElf)}ms (${bytesObj.tamanho()}B)")
                objetosLinkar.empilhar(bytesObj)
                nomesObjetos.empilhar(arqPath)
            }
        }

        se (!somenteAsm e !somenteObjeto) {
            var libsDinamicas: texto[] = []
            para (var k: inteiro = 0; k < libsCli.tamanho(); k++) {
                const resLib: (texto, logico) = resolverBibliotecaCli(libsCli[k], dirsLib)
                se (resLib[1]) {
                    objetosLinkar.empilhar(lerBinario(resLib[0]))
                    nomesObjetos.empilhar(resLib[0])
                } senao {
                    libsDinamicas.empilhar(resLib[0])
                }
            }
            const diagLink: qualquer = diagMod.ContextoDiag(wall, wextra, werror, modoCor,
                formatoJson, catsDesab)
            se (verbose) escreverErro("[dcc] linkando ${objetosLinkar.tamanho()} entrada(s) ELF64/ar -> executavel")
            cron.reiniciar()
            const elfExec: inteiro[] = lnkMod.linkarObjetosELF64(objetosLinkar, nomesObjetos,
                libsDinamicas, diagLink)
            tLnk = tLnk + cron.milisegundos()
            const destExec: texto = caminhoSaida.tamanho() > 0 ? caminhoSaida : "a.out"
            gravarBinario(destExec, elfExec, verdadeiro)
            se (verbose) escreverErro("[dcc] executavel ELF64 gerado em ${destExec} (${elfExec.tamanho()} bytes)")
        }

        se (timeReport) {
            const totalMs: real = tPre + tLex + tPar + tSem + tIr + tOpt + tCg + tElf + tLnk
            escreverErro("[dcc-time] preprocess=${inteiro(tPre)}ms lex=${inteiro(tLex)}ms parse=${inteiro(tPar)}ms sema=${inteiro(tSem)}ms ir=${inteiro(tIr)}ms opt+verify=${inteiro(tOpt)}ms codegen=${inteiro(tCg)}ms elf_obj=${inteiro(tElf)}ms link=${inteiro(tLnk)}ms total=${inteiro(totalMs)}ms")
        }
        retorna 0
    } pegue (erro: Excecao) {
        escreverErro(erro.mensagem)
        retorna 1
    }
}
