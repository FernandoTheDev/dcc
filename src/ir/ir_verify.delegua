// Verificador estrutural rigoroso de invariantes da IR SSA / CFG do DCC.
// Garante que nenhuma IR corrompida alcance o backend x86-64:
// - Funcoes e blocos nao vazios
// - Definicao unica (SSA) e registradores dentro de [0, numRegs)
// - Todos os operandos usados existem e foram definidos
// - Terminador obrigatorio no final de cada bloco e nenhuma instrucao apos terminador
// - Alvos de salto validos, indices de string e global dentro dos limites

funcao ehTerminadorIR(op: qualquer, OpI: qualquer): logico {
    retorna op == OpI.Br ou op == OpI.BrCond ou op == OpI.Ret ou op == OpI.RetPair ou op == OpI.FRet
}

funcao checarRegDefinido(reg: inteiro, defs: qualquer, numRegs: inteiro, nomeFn: texto, diagMod: qualquer): vazio {
    se (reg < 0 ou reg >= numRegs) {
        falhar diagMod.ErroDCC("IR invalida (ICE): registrador fora dos limites %${reg} (numRegs=${numRegs}) em '${nomeFn}'",
            "", 0, 0, "E9001", verdadeiro)
    }

    se (defs.obter(reg) == 0) {
        falhar diagMod.ErroDCC("IR invalida (ICE): uso de registrador nao definido %${reg} em '${nomeFn}'",
            "", 0, 0, "E9002", verdadeiro)
    }
}

funcao verificarFuncaoSSA(fn: qualquer, nStrings: inteiro, nGlobais: inteiro, arena: qualquer = nulo): logico {
    const tMod: qualquer = importar("../types/tipos.delegua")
    const diagMod: qualquer = importar("../diagnostics/diag.delegua")
    const optMod: qualquer = importar("ir_opt.delegua")
    const memMod = importar("cgd:memoria")
    const OpI: qualquer = tMod.OpIR

    se (fn.blocos.tamanho() == 0) {
        falhar diagMod.ErroDCC("IR invalida (ICE): funcao '${fn.nome}' sem blocos basicos",
            "", 0, 0, "E9003", verdadeiro)
    }

    var mapaBlocos: dicionario = {}
    para (var b: inteiro = 0; b < fn.blocos.tamanho(); b++) {
        const nomeB: texto = fn.blocos[b].nome
        se (mapaBlocos.contem(nomeB)) {
            falhar diagMod.ErroDCC("IR invalida (ICE): bloco duplicado '${nomeB}' em '${fn.nome}'",
                "", 0, 0, "E9003", verdadeiro)
        }
        mapaBlocos[nomeB] = verdadeiro
    }

    const ar = memMod.Arena(16384, 33554432)
    const nRegs: inteiro = fn.numRegs > 0 ? fn.numRegs : 1
    const defs = ar.criarBytes(nRegs)

    const cCopy: inteiro = inteiro(OpI.Copy)
    const cAddrGlobal: inteiro = inteiro(OpI.AddrGlobal)
    const cAddrStr: inteiro = inteiro(OpI.AddrStr)
    const cAlloca: inteiro = inteiro(OpI.Alloca)
    const cLoad: inteiro = inteiro(OpI.Load)
    const cStore: inteiro = inteiro(OpI.Store)
    const cFLoad: inteiro = inteiro(OpI.FLoad)
    const cFStore: inteiro = inteiro(OpI.FStore)
    const cAdd: inteiro = inteiro(OpI.Add)
    const cUGe: inteiro = inteiro(OpI.UGe)
    const cNeg: inteiro = inteiro(OpI.Neg)
    const cBitNot: inteiro = inteiro(OpI.BitNot)
    const cFAdd: inteiro = inteiro(OpI.FAdd)
    const cFDiv: inteiro = inteiro(OpI.FDiv)
    const cFNeg: inteiro = inteiro(OpI.FNeg)
    const cFEq: inteiro = inteiro(OpI.FEq)
    const cFGe: inteiro = inteiro(OpI.FGe)
    const cItoF: inteiro = inteiro(OpI.ItoF)
    const cToBool: inteiro = inteiro(OpI.ToBool)
    const cCall: inteiro = inteiro(OpI.Call)
    const cCallIndirect: inteiro = inteiro(OpI.CallIndirect)
    const cBr: inteiro = inteiro(OpI.Br)
    const cBrCond: inteiro = inteiro(OpI.BrCond)
    const cRet: inteiro = inteiro(OpI.Ret)
    const cRetPair: inteiro = inteiro(OpI.RetPair)
    const cFRet: inteiro = inteiro(OpI.FRet)

    // Passe 1: coleta e valida unicidade de definicoes SSA + terminadores + limites de indices
    para (var b: inteiro = 0; b < fn.blocos.tamanho(); b++) {
        const bb: qualquer = fn.blocos[b]
        const nI: inteiro = bb.insts.tamanho()
        se (nI == 0) {
            falhar diagMod.ErroDCC("IR invalida (ICE): bloco vazio '${bb.nome}' em '${fn.nome}'",
                "", 0, 0, "E9003", verdadeiro)
        }
        para (var i: inteiro = 0; i < nI; i++) {
            const inst: qualquer = bb.insts[i]
            const opI: inteiro = inteiro(inst.op)
            se (i + 1 < nI e opI >= cBr e opI <= cFRet) {
                falhar diagMod.ErroDCC("IR invalida (ICE): instrucao apos terminador no bloco '${bb.nome}' em '${fn.nome}'",
                    "", 0, 0, "E9004", verdadeiro)
            }
            se (inst.dst >= 0) {
                se (inst.dst >= fn.numRegs) {
                    falhar diagMod.ErroDCC("IR invalida (ICE): dst %${inst.dst} >= numRegs (${fn.numRegs}) em '${fn.nome}'",
                        "", 0, 0, "E9001", verdadeiro)
                }
                se (defs.obter(inst.dst) != 0) {
                    falhar diagMod.ErroDCC("IR invalida (ICE): violacao SSA no reg %${inst.dst} em '${fn.nome}'",
                        "", 0, 0, "E9005", verdadeiro)
                }
                defs.definir(inst.dst, 1)
            }
            se (inst.dst2 >= 0) {
                se (inst.dst2 >= fn.numRegs) {
                    falhar diagMod.ErroDCC("IR invalida (ICE): dst2 %${inst.dst2} >= numRegs (${fn.numRegs}) em '${fn.nome}'",
                        "", 0, 0, "E9001", verdadeiro)
                }
                se (defs.obter(inst.dst2) != 0) {
                    falhar diagMod.ErroDCC("IR invalida (ICE): violacao SSA no reg %${inst.dst2} em '${fn.nome}'",
                        "", 0, 0, "E9005", verdadeiro)
                }
                defs.definir(inst.dst2, 1)
            }
            se (opI == cBr e !mapaBlocos.contem(inst.alvo1)) {
                falhar diagMod.ErroDCC("IR invalida (ICE): alvo Br inexistente '${inst.alvo1}' em '${fn.nome}'",
                    "", 0, 0, "E9006", verdadeiro)
            }
            se (opI == cBrCond e (!mapaBlocos.contem(inst.alvo1) ou !mapaBlocos.contem(inst.alvo2))) {
                falhar diagMod.ErroDCC("IR invalida (ICE): alvo BrCond inexistente em '${fn.nome}'",
                    "", 0, 0, "E9006", verdadeiro)
            }
            se (opI == cAddrStr e (inst.a < 0 ou inst.a >= nStrings)) {
                falhar diagMod.ErroDCC("IR invalida (ICE): indice de string fora dos limites (${inst.a}/${nStrings}) em '${fn.nome}'",
                    "", 0, 0, "E9007", verdadeiro)
            }
            se (opI == cAddrGlobal e (inst.a < 0 ou inst.a >= nGlobais)) {
                falhar diagMod.ErroDCC("IR invalida (ICE): indice de global fora dos limites (${inst.a}/${nGlobais}) em '${fn.nome}'",
                    "", 0, 0, "E9007", verdadeiro)
            }
        }
        const ultOp: inteiro = inteiro(bb.insts[nI - 1].op)
        se (ultOp < cBr ou ultOp > cFRet) {
            falhar diagMod.ErroDCC("IR invalida (ICE): bloco '${bb.nome}' em '${fn.nome}' sem terminador",
                "", 0, 0, "E9004", verdadeiro)
        }
    }

    // Passe 2: verifica se todos os operandos referenciados foram definidos (despacho estatico em FatiaBytes)
    para (var b: inteiro = 0; b < fn.blocos.tamanho(); b++) {
        const bb: qualquer = fn.blocos[b]
        para (var i: inteiro = 0; i < bb.insts.tamanho(); i++) {
            const inst: qualquer = bb.insts[i]
            const opI: inteiro = inteiro(inst.op)
            se (opI == cStore ou opI == cFStore ou opI == cRetPair ou (opI >= cAdd e opI <= cUGe) ou (opI >= cFAdd e opI <= cFDiv) ou (opI >= cFEq e opI <= cFGe)) {
                se (inst.a < 0 ou inst.a >= fn.numRegs ou defs.obter(inst.a) == 0) {
                    checarRegDefinido(inst.a, defs, fn.numRegs, fn.nome, diagMod)
                }
                se (inst.b < 0 ou inst.b >= fn.numRegs ou defs.obter(inst.b) == 0) {
                    checarRegDefinido(inst.b, defs, fn.numRegs, fn.nome, diagMod)
                }
            } senao se (opI == cLoad ou opI == cFLoad ou opI == cAlloca ou opI == cCopy ou opI == cBrCond ou opI == cRet ou opI == cFRet ou (opI >= cNeg e opI <= cBitNot) ou opI == cFNeg ou (opI >= cItoF e opI <= cToBool)) {
                se (inst.a < 0 ou inst.a >= fn.numRegs ou defs.obter(inst.a) == 0) {
                    checarRegDefinido(inst.a, defs, fn.numRegs, fn.nome, diagMod)
                }
            } senao se (opI >= cCall e opI <= cCallIndirect) {
                const ci: qualquer = inst.callInfo
                se (opI == cCallIndirect e (inst.a < 0 ou inst.a >= fn.numRegs ou defs.obter(inst.a) == 0)) {
                    checarRegDefinido(inst.a, defs, fn.numRegs, fn.nome, diagMod)
                }
                se (ci.sretReg >= 0 e (ci.sretReg >= fn.numRegs ou defs.obter(ci.sretReg) == 0)) {
                    checarRegDefinido(ci.sretReg, defs, fn.numRegs, fn.nome, diagMod)
                }
                para (var k: inteiro = 0; k < ci.args.tamanho(); k++) {
                    const ra: inteiro = ci.args[k]
                    se (ra < 0 ou ra >= fn.numRegs ou defs.obter(ra) == 0) {
                        checarRegDefinido(ra, defs, fn.numRegs, fn.nome, diagMod)
                    }
                }
            }
        }
    }

    ar.liberar()
    retorna verdadeiro
}

funcao verificarModuloSSA(modulo: qualquer): logico {
    const memMod = importar("cgd:memoria")
    const nStrings: inteiro = modulo.stringsBytes.tamanho() > 0 ? modulo.stringsBytes.tamanho() : modulo.strings.tamanho()
    const nGlobais: inteiro = modulo.globais.tamanho()
    const arena: qualquer = memMod.Arena(32768, 33554432)

    para (var f: inteiro = 0; f < modulo.funcoes.tamanho(); f++) {
        verificarFuncaoSSA(modulo.funcoes[f], nStrings, nGlobais, arena)
    }

    arena.liberar()
    retorna verdadeiro
}
