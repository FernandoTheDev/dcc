// Otimizador da IR SSA do DCC:
// Constant Propagation & Folding (seguro para 32/64 bits, INT64_MIN/-1 e shifts),
// Simplificacao Algebrica, Copy Propagation, Eliminacao de Blocos Inalcancaveis (CFG) e DCE.
// Respeita rigorosamente acessos 'volatile' e instrucoes com efeitos colaterais.

funcao ehOpBinariaIntPura(op: qualquer, OpI: qualquer): logico {
    const v: inteiro = inteiro(op)
    retorna v >= inteiro(OpI.Add) e v <= inteiro(OpI.UGe)
}

funcao ehOpBinariaFloat(op: qualquer, OpI: qualquer): logico {
    const v: inteiro = inteiro(op)
    retorna (v >= inteiro(OpI.FAdd) e v <= inteiro(OpI.FDiv)) ou (v >= inteiro(OpI.FEq) e v <= inteiro(OpI.FGe))
}

funcao normalizarLarguraInt(v: inteiro, largura: inteiro, semSinal: logico): inteiro {
    se (largura == 4) {
        const baixo32: inteiro = v & 4294967295
        se (semSinal) retorna baixo32
        se ((baixo32 & 2147483648) != 0) retorna baixo32 - 4294967296
        retorna baixo32
    }

    retorna v
}

funcao dobrarOpInt(op: qualquer, OpI: qualquer, a: inteiro, b: inteiro, largura: inteiro,
    semSinal: logico): inteiro {
    var r: inteiro = 0
    escolha (op) {
        caso OpI.Add: r = a + b
        caso OpI.Sub: r = a - b
        caso OpI.Mul: r = a * b
        caso OpI.SDiv: r = a \ b
        caso OpI.SMod: r = a % b
        caso OpI.BitAnd: r = a & b
        caso OpI.BitOr: r = a | b
        caso OpI.BitXor: r = a ^ b
        caso OpI.Shl: r = a << b
        caso OpI.AShr: r = a >> b
        caso OpI.Eq: retorna a == b ? 1 : 0
        caso OpI.Neq: retorna a != b ? 1 : 0
        caso OpI.SLt: retorna a < b ? 1 : 0
        caso OpI.SLe: retorna a <= b ? 1 : 0
        caso OpI.SGt: retorna a > b ? 1 : 0
        caso OpI.SGe: retorna a >= b ? 1 : 0
        padrao: retorna 0
    }

    retorna normalizarLarguraInt(r, largura, semSinal)
}

funcao substituirRegArena(reg: inteiro, copias: qualquer, nRegs: inteiro): inteiro {
    var cur: inteiro = reg
    var passos: inteiro = 0
    enquanto (cur >= 0 e cur < nRegs e passos < 32) {
        const nxt: inteiro = copias.obter(cur)
        se (nxt < 0) sustar
        cur = nxt
        passos++
    }

    retorna cur
}

funcao otimizarFuncaoSSA(fn: qualquer, stats: qualquer, arena: qualquer = nulo): vazio {
    se (fn.blocos.tamanho() == 0) retorna
    const tMod = importar("../types/tipos.delegua")
    const memMod = importar("cgd:memoria")
    const OpI = tMod.OpIR
    const int64Min: inteiro = -9223372036854775807 - 1

    const ar = memMod.Arena(16384, 67108864)
    const nRegs: inteiro = fn.numRegs > 0 ? fn.numRegs : 1

    // Cache de codigos inteiros de OpIR para verificacoes O(1) sem lookup de propriedade em loops quentes
    const cConst: inteiro = inteiro(OpI.Const)
    const cFConst: inteiro = inteiro(OpI.FConst)
    const cCopy: inteiro = inteiro(OpI.Copy)
    const cAddrSlot: inteiro = inteiro(OpI.AddrSlot)
    const cAddrStr: inteiro = inteiro(OpI.AddrStr)
    const cAlloca: inteiro = inteiro(OpI.Alloca)
    const cLoad: inteiro = inteiro(OpI.Load)
    const cStore: inteiro = inteiro(OpI.Store)
    const cFLoad: inteiro = inteiro(OpI.FLoad)
    const cFStore: inteiro = inteiro(OpI.FStore)
    const cAdd: inteiro = inteiro(OpI.Add)
    const cSub: inteiro = inteiro(OpI.Sub)
    const cMul: inteiro = inteiro(OpI.Mul)
    const cSDiv: inteiro = inteiro(OpI.SDiv)
    const cUDiv: inteiro = inteiro(OpI.UDiv)
    const cSMod: inteiro = inteiro(OpI.SMod)
    const cUMod: inteiro = inteiro(OpI.UMod)
    const cShl: inteiro = inteiro(OpI.Shl)
    const cAShr: inteiro = inteiro(OpI.AShr)
    const cLShr: inteiro = inteiro(OpI.LShr)
    const cULt: inteiro = inteiro(OpI.ULt)
    const cUGe: inteiro = inteiro(OpI.UGe)
    const cNeg: inteiro = inteiro(OpI.Neg)
    const cLogNot: inteiro = inteiro(OpI.LogNot)
    const cBitNot: inteiro = inteiro(OpI.BitNot)
    const cFAdd: inteiro = inteiro(OpI.FAdd)
    const cFDiv: inteiro = inteiro(OpI.FDiv)
    const cFNeg: inteiro = inteiro(OpI.FNeg)
    const cFEq: inteiro = inteiro(OpI.FEq)
    const cFGe: inteiro = inteiro(OpI.FGe)
    const cItoF: inteiro = inteiro(OpI.ItoF)
    const cToBool: inteiro = inteiro(OpI.ToBool)
    const cCall: inteiro = inteiro(OpI.Call)
    const cCallIndirect: inteiro = inteiro(OpI.CallIndirect)
    const cBr: inteiro = inteiro(OpI.Br)
    const cBrCond: inteiro = inteiro(OpI.BrCond)
    const cRet: inteiro = inteiro(OpI.Ret)
    const cRetPair: inteiro = inteiro(OpI.RetPair)
    const cFRet: inteiro = inteiro(OpI.FRet)

    // 1. Constant Propagation, Folding, Simplificacao Algebrica e Copy Propagation (em Arena nativa, 0 GC churn)
    const constFlag = ar.criarBytes(nRegs)
    const constVals = ar.criarInt64(nRegs, 0)
    const copias = ar.criarInt64(nRegs, -1)
    var temCopias: logico = falso

    para (var b: inteiro = 0; b < fn.blocos.tamanho(); b++) {
        const bb: qualquer = fn.blocos[b]
        para (var i: inteiro = 0; i < bb.insts.tamanho(); i++) {
            const inst: qualquer = bb.insts[i]
            const opI: inteiro = inteiro(inst.op)
            const ehBinInt: logico = opI >= cAdd e opI <= cUGe
            const ehBinFlt: logico = (opI >= cFAdd e opI <= cFDiv) ou (opI >= cFEq e opI <= cFGe)

            // Aplica propagacao de copias nos operandos (apenas quando existem copias na funcao)
            se (temCopias e opI != cConst e opI != cFConst e !(opI >= cAddrSlot e opI <= cAddrStr) e opI != cBr) {
                var curA: inteiro = inst.a
                var pA: inteiro = 0
                enquanto (curA >= 0 e curA < nRegs e pA < 32) {
                    const nxtA: inteiro = copias.obter(curA)
                    se (nxtA < 0) sustar
                    curA = nxtA
                    pA++
                }
                se (curA != inst.a) {
                    inst.a = curA
                    stats.copiasPropagadas++
                }
                se (opI == cStore ou opI == cFStore ou opI == cRetPair ou ehBinInt ou ehBinFlt) {
                    var curB: inteiro = inst.b
                    var pB: inteiro = 0
                    enquanto (curB >= 0 e curB < nRegs e pB < 32) {
                        const nxtB: inteiro = copias.obter(curB)
                        se (nxtB < 0) sustar
                        curB = nxtB
                        pB++
                    }
                    se (curB != inst.b) {
                        inst.b = curB
                        stats.copiasPropagadas++
                    }
                }
                se (opI >= cCall e opI <= cCallIndirect) {
                    const ci: qualquer = inst.callInfo
                    se (ci.sretReg >= 0) {
                        var curSr: inteiro = ci.sretReg
                        var pSr: inteiro = 0
                        enquanto (curSr >= 0 e curSr < nRegs e pSr < 32) {
                            const nxtSr: inteiro = copias.obter(curSr)
                            se (nxtSr < 0) sustar
                            curSr = nxtSr
                            pSr++
                        }
                        se (curSr != ci.sretReg) {
                            ci.sretReg = curSr
                            stats.copiasPropagadas++
                        }
                    }
                    para (var k: inteiro = 0; k < ci.args.tamanho(); k++) {
                        var curK: inteiro = ci.args[k]
                        var pK: inteiro = 0
                        enquanto (curK >= 0 e curK < nRegs e pK < 32) {
                            const nxtK: inteiro = copias.obter(curK)
                            se (nxtK < 0) sustar
                            curK = nxtK
                            pK++
                        }
                        se (curK != ci.args[k]) {
                            ci.args[k] = curK
                            stats.copiasPropagadas++
                        }
                    }
                }
            }

            se (opI == cConst) {
                se (inst.dst >= 0 e inst.dst < nRegs) {
                    constFlag.definir(inst.dst, 1)
                    constVals.definir(inst.dst, inst.a)
                }
            } senao se (opI == cCopy) {
                se (inst.dst >= 0 e inst.dst < nRegs e inst.a >= 0) {
                    copias.definir(inst.dst, inst.a)
                    temCopias = verdadeiro
                }
            } senao se (ehBinInt) {
                const temA: logico = inst.a >= 0 e inst.a < nRegs e constFlag.obter(inst.a) != 0
                const temB: logico = inst.b >= 0 e inst.b < nRegs e constFlag.obter(inst.b) != 0
                se (temA e temB) {
                    const va: inteiro = constVals.obter(inst.a)
                    const vb: inteiro = constVals.obter(inst.b)
                    const opUnsigned: logico = opI == cUDiv ou opI == cUMod ou opI == cLShr ou (opI >= cULt e opI <= cUGe)
                    const ehShift: logico = opI == cShl ou opI == cAShr
                    const maxSh: inteiro = inst.largura == 4 ? 32 : 64
                    const shiftOk: logico = !ehShift ou (vb >= 0 e vb < maxSh)
                    const divOk: logico = (opI != cSDiv e opI != cSMod) ou (vb != 0 e !(va == int64Min e vb == -1) e !(inst.largura == 4 e va == -2147483648 e vb == -1))
                    se (!opUnsigned e shiftOk e divOk) {
                        const res: inteiro = dobrarOpInt(inst.op, OpI, va, vb, inst.largura,
                            inst.ehSemSinal)
                        inst.op = OpI.Const
                        inst.a = res
                        inst.b = 0
                        se (inst.dst >= 0 e inst.dst < nRegs) {
                            constFlag.definir(inst.dst, 1)
                            constVals.definir(inst.dst, res)
                        }
                        stats.dobras++
                    }
                } senao se (temB e inst.largura == 8) {
                    const vb: inteiro = constVals.obter(inst.b)
                    se ((opI == cAdd ou opI == cSub) e vb == 0) {
                        inst.op = OpI.Copy
                        inst.b = 0
                        se (inst.dst >= 0 e inst.dst < nRegs e inst.a >= 0) {
                            copias.definir(inst.dst, inst.a)
                            temCopias = verdadeiro
                        }
                        stats.simplificacoes++
                    } senao se (opI == cMul e vb == 1) {
                        inst.op = OpI.Copy
                        inst.b = 0
                        se (inst.dst >= 0 e inst.dst < nRegs e inst.a >= 0) {
                            copias.definir(inst.dst, inst.a)
                            temCopias = verdadeiro
                        }
                        stats.simplificacoes++
                    } senao se (opI == cMul e vb == 0) {
                        inst.op = OpI.Const
                        inst.a = 0
                        inst.b = 0
                        se (inst.dst >= 0 e inst.dst < nRegs) {
                            constFlag.definir(inst.dst, 1)
                            constVals.definir(inst.dst, 0)
                        }
                        stats.simplificacoes++
                    }
                }
            } senao se (opI == cNeg ou opI == cLogNot ou opI == cBitNot ou opI == cToBool) {
                se (inst.a >= 0 e inst.a < nRegs e constFlag.obter(inst.a) != 0) {
                    const va: inteiro = constVals.obter(inst.a)
                    var res: inteiro = -va
                    se (opI == cLogNot) res = va == 0 ? 1 : 0
                    senao se (opI == cBitNot) res = normalizarLarguraInt(~va, inst.largura,
                        inst.ehSemSinal)
                    senao se (opI == cNeg) res = normalizarLarguraInt(-va, inst.largura,
                        inst.ehSemSinal)
                    senao se (opI == cToBool) res = va != 0 ? 1 : 0
                    inst.op = OpI.Const
                    inst.a = res
                    se (inst.dst >= 0 e inst.dst < nRegs) {
                        constFlag.definir(inst.dst, 1)
                        constVals.definir(inst.dst, res)
                    }
                    stats.dobras++
                }
            } senao se (opI == cBrCond) {
                se (inst.a >= 0 e inst.a < nRegs e constFlag.obter(inst.a) != 0) {
                    const condVal: inteiro = constVals.obter(inst.a)
                    inst.op = OpI.Br
                    inst.alvo1 = condVal != 0 ? inst.alvo1 : inst.alvo2
                    inst.alvo2 = ""
                    inst.a = 0
                    stats.dobras++
                }
            }
        }
    }

    // 2. Eliminacao de blocos inalcancaveis no CFG
    var mapaBlocos: dicionario = {}
    para (var b: inteiro = 0; b < fn.blocos.tamanho(); b++) {
        mapaBlocos[fn.blocos[b].nome] = fn.blocos[b]
    }

    var alcancaveis: dicionario = {}
    var fila: texto[] = [fn.blocos[0].nome]
    alcancaveis[fn.blocos[0].nome] = verdadeiro
    enquanto (fila.tamanho() > 0) {
        const atualNome: texto = fila.removerUltimo()
        const bb: qualquer = mapaBlocos[atualNome]
        const nI: inteiro = bb.insts.tamanho()
        se (nI > 0) {
            const ult: qualquer = bb.insts[nI - 1]
            const opU: inteiro = inteiro(ult.op)
            se (opU == cBr ou opU == cBrCond) {
                se (!alcancaveis.contem(ult.alvo1)) {
                    alcancaveis[ult.alvo1] = verdadeiro
                    fila.empilhar(ult.alvo1)
                }
                se (opU == cBrCond e !alcancaveis.contem(ult.alvo2)) {
                    alcancaveis[ult.alvo2] = verdadeiro
                    fila.empilhar(ult.alvo2)
                }
            }
        }
    }

    var vivos: qualquer[] = []
    para (var b: inteiro = 0; b < fn.blocos.tamanho(); b++) {
        se (alcancaveis.contem(fn.blocos[b].nome)) {
            vivos.empilhar(fn.blocos[b])
        } senao {
            stats.blocosMortos++
        }
    }

    fn.blocos = vivos

    // 3. Dead Code Elimination (DCE) por contagem de usos em Arena nativa (O(1) sem lookups de enum)
    ar.limpar()
    const usos = ar.criarInt64(nRegs, 0)
    para (var b: inteiro = 0; b < fn.blocos.tamanho(); b++) {
        const bb: qualquer = fn.blocos[b]
        para (var i: inteiro = 0; i < bb.insts.tamanho(); i++) {
            const inst: qualquer = bb.insts[i]
            const opI: inteiro = inteiro(inst.op)
            se (opI == cStore ou opI == cFStore ou opI == cRetPair ou (opI >= cAdd e opI <= cUGe) ou (opI >= cFAdd e opI <= cFDiv) ou (opI >= cFEq e opI <= cFGe)) {
                se (inst.a >= 0 e inst.a < fn.numRegs) usos.definir(inst.a, usos.obter(inst.a) + 1)
                se (inst.b >= 0 e inst.b < fn.numRegs) usos.definir(inst.b, usos.obter(inst.b) + 1)
            } senao se (opI == cLoad ou opI == cFLoad ou opI == cAlloca ou opI == cCopy ou opI == cBrCond ou opI == cRet ou opI == cFRet ou (opI >= cNeg e opI <= cBitNot) ou opI == cFNeg ou (opI >= cItoF e opI <= cToBool)) {
                se (inst.a >= 0 e inst.a < fn.numRegs) usos.definir(inst.a, usos.obter(inst.a) + 1)
            } senao se (opI >= cCall e opI <= cCallIndirect) {
                const ci: qualquer = inst.callInfo
                se (opI == cCallIndirect e inst.a >= 0 e inst.a < fn.numRegs) usos.definir(inst.a,
                    usos.obter(inst.a) + 1)
                se (ci.sretReg >= 0 e ci.sretReg < fn.numRegs) usos.definir(ci.sretReg, usos.obter(ci.sretReg) + 1)
                para (var k: inteiro = 0; k < ci.args.tamanho(); k++) {
                    const ra: inteiro = ci.args[k]
                    se (ra >= 0 e ra < fn.numRegs) usos.definir(ra, usos.obter(ra) + 1)
                }
            }
        }
    }

    var mudou: logico = verdadeiro
    enquanto (mudou) {
        mudou = falso
        para (var b: inteiro = fn.blocos.tamanho() - 1; b >= 0; b--) {
            const bb: qualquer = fn.blocos[b]
            const nInstsB: inteiro = bb.insts.tamanho()
            var removidosB: inteiro = 0
            const flagsDrop = ar.criarBytes(nInstsB > 0 ? nInstsB : 1)
            para (var i: inteiro = nInstsB - 1; i >= 0; i--) {
                const inst: qualquer = bb.insts[i]
                se (inst.dst < 0 ou inst.dst2 >= 0 ou inst.ehVolatile) continua
                const opI: inteiro = inteiro(inst.op)
                const ehSideEff: logico = opI == cLoad ou opI == cFLoad ou opI == cAlloca ou (opI >= cSDiv e opI <= cUMod) ou (opI >= cCall e opI <= cCallIndirect)
                se (!ehSideEff e inst.dst < fn.numRegs e usos.obter(inst.dst) == 0) {
                    flagsDrop.definir(i, 1)
                    removidosB++
                    stats.dceRemovidas++
                    mudou = verdadeiro
                    se (opI == cCopy ou (opI >= cNeg e opI <= cBitNot) ou opI == cFNeg ou (opI >= cItoF e opI <= cToBool)) {
                        se (inst.a >= 0 e inst.a < fn.numRegs) usos.definir(inst.a, usos.obter(inst.a) - 1)
                    } senao se ((opI >= cAdd e opI <= cUGe) ou (opI >= cFAdd e opI <= cFDiv) ou (opI >= cFEq e opI <= cFGe)) {
                        se (inst.a >= 0 e inst.a < fn.numRegs) usos.definir(inst.a, usos.obter(inst.a) - 1)
                        se (inst.b >= 0 e inst.b < fn.numRegs) usos.definir(inst.b, usos.obter(inst.b) - 1)
                    }
                }
            }
            se (removidosB > 0) {
                var novas: qualquer[] = []
                para (var i: inteiro = 0; i < nInstsB; i++) {
                    se (flagsDrop.obter(i) == 0) novas.empilhar(bb.insts[i])
                }
                bb.insts = novas
            }
        }
    }

    ar.liberar()
}

funcao otimizarModuloSSA(modulo: qualquer): qualquer {
    const irTipos: qualquer = importar("ir_tipos.delegua")
    const memMod: qualquer = importar("cgd:memoria")
    const stats: qualquer = irTipos.StatsSSA()
    const arena: qualquer = memMod.Arena(65536, 67108864)

    para (var f: inteiro = 0; f < modulo.funcoes.tamanho(); f++) {
        otimizarFuncaoSSA(modulo.funcoes[f], stats, arena)
    }

    arena.liberar()
    retorna stats
}
