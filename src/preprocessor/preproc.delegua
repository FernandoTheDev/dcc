// Fase 0 (ISO C99 Fases 1-4 + compatibilidade com headers reais do sistema):
// Pre-processador C99/GNU99 real orientado a tokens para o DCC (Delegua C Compiler).
// Resolve diretamente /usr/include, diretorios freestanding do sistema e -I,
// sem tabelas fixas de headers ou registro artificial de simbolos da libc.
// Endurecido contra comentarios /* nao fechados, bombas de expansao de macros,
// includes ciclicos, aninhamento extremo de #if e path traversal malicioso.

classe QuadroIf {
    paiAtivo: logico
    esteAtivo: logico
    jaTomouRamo: logico
    viuElse: logico

    construtor(paiAtivo: logico, esteAtivo: logico) {
        isto.paiAtivo = paiAtivo
        isto.esteAtivo = esteAtivo
        isto.jaTomouRamo = esteAtivo
        isto.viuElse = falso
    }
}

funcao trigraphByte(b: inteiro): inteiro {
    escolha (b) {
        caso 61: retorna 35 // '=' -> '#'
        caso 47: retorna 92 // '/' -> '\'
        caso 39: retorna 94 // ''' -> '^'
        caso 40: retorna 91 // '(' -> '['
        caso 41: retorna 93 // ')' -> ']'
        caso 33: retorna 124 // '!' -> '|'
        caso 60: retorna 123 // '<' -> '{'
        caso 62: retorna 125 // '>' -> '}'
        caso 45: retorna 126 // '-' -> '~'
        padrao: retorna -1
    }

    retorna -1
}

// Fase 1 + Fase 2 + Fase 3 em O(N) sobre vetor de bytes.
// Pula copias intermediarias quando nao ha CRLF/trigrafos nem line-splicing.
// Detecta e reporta comentario de bloco /* nao fechado com linha exata.
funcao fasesIniciaisELimpezaPP(fonte: texto, nomeArquivo: texto, diag: qualquer, pilhaInc: texto[] = [],
    bytesModArg: qualquer = nulo): texto {
    var bytesMod: qualquer = bytesModArg
    se (bytesMod == nulo) bytesMod = importar("cgd:bytes")
    const raw: inteiro[] = bytesMod.Bytes.deTexto(fonte).paraVetor()
    const n: inteiro = raw.tamanho()

    // Fase 1: trigraphs + normalizacao CRLF (apenas se necessario)
    var t1: inteiro[] = raw
    se (fonte.contem("\r") ou fonte.contem("??")) {
        t1 = []
        var i: inteiro = 0
        enquanto (i < n) {
            const b: inteiro = raw[i]
            se (b == 13) {
                se (i + 1 < n e raw[i + 1] == 10) i++
                t1.empilhar(10)
                i++
                continua
            }
            se (b == 63 e i + 2 < n e raw[i + 1] == 63) {
                const rep: inteiro = trigraphByte(raw[i + 2])
                se (rep >= 0) {
                    t1.empilhar(rep)
                    i = i + 3
                    continua
                }
            }
            t1.empilhar(b)
            i++
        }
    }

    // Fase 2: line splicing ('\' seguido de '\n') (apenas se necessario)
    var t2: inteiro[] = t1
    se (fonte.contem("\\\n") ou t1 != raw) {
        t2 = []
        var j: inteiro = 0
        const m: inteiro = t1.tamanho()
        enquanto (j < m) {
            se (t1[j] == 92 e j + 1 < m e t1[j + 1] == 10) {
                j = j + 2
                continua
            }
            t2.empilhar(t1[j])
            j++
        }
    }

    // Fase 3: remove comentarios mantendo quebras de linha e valida fechamento de /* */
    var out: inteiro[] = []
    var k: inteiro = 0
    const p: inteiro = t2.tamanho()
    var emStr: logico = falso
    var emChr: logico = falso
    var linhaAtual: inteiro = 1
    enquanto (k < p) {
        const b: inteiro = t2[k]
        se (b == 10) linhaAtual++
        se (emStr) {
            out.empilhar(b)
            se (b == 92 e k + 1 < p) {
                k++
                se (t2[k] == 10) linhaAtual++
                out.empilhar(t2[k])
            } senao se (b == 34 ou b == 10) {
                emStr = falso
            }
            k++
            continua
        }
        se (emChr) {
            out.empilhar(b)
            se (b == 92 e k + 1 < p) {
                k++
                se (t2[k] == 10) linhaAtual++
                out.empilhar(t2[k])
            } senao se (b == 39 ou b == 10) {
                emChr = falso
            }
            k++
            continua
        }
        se (b == 34) {
            emStr = verdadeiro
            out.empilhar(b)
            k++
            continua
        }
        se (b == 39) {
            emChr = verdadeiro
            out.empilhar(b)
            k++
            continua
        }
        se (b == 47 e k + 1 < p e t2[k + 1] == 47) {
            out.empilhar(32)
            enquanto (k < p e t2[k] != 10) k++
            continua
        }
        se (b == 47 e k + 1 < p e t2[k + 1] == 42) {
            const linIniCom: inteiro = linhaAtual
            out.empilhar(32)
            k = k + 2
            var fechou: logico = falso
            enquanto (k < p) {
                se (k + 1 < p e t2[k] == 42 e t2[k + 1] == 47) {
                    k = k + 2
                    fechou = verdadeiro
                    sustar
                }
                se (t2[k] == 10) {
                    linhaAtual++
                    out.empilhar(10)
                }
                k++
            }
            se (!fechou) {
                diag.erroDireto(nomeArquivo, linIniCom, 1, "comentario de bloco '/*' nao fechado",
                    "", "", "E1001", 2, pilhaInc)
            }
            continua
        }
        out.empilhar(b)
        k++
    }

    retorna bytesMod.Bytes.deVetor(out).paraTexto()
}

// Descoberta de diretorios do sistema sem uso de /bin/sh (Processo.executar("find") + cgd:arquivos)
funcao descobrirDirsSistema(): texto[] {
    const procMod: qualquer = importar("cgd:processo")
    const arqMod: qualquer = importar("cgd:arquivos")
    const texMod: qualquer = importar("cgd:textos")
    var dirs: texto[] = []
    var vistos: dicionario = {}

    // Seleciona exatamente um diretorio freestanding nativo x86-64 (gcc ou clang)
    var freeDir: texto = ""
    const resFind: qualquer = procMod.Processo.executar("find", [
        "/usr/lib/gcc",
        "/usr/lib/clang",
        "-maxdepth",
        "4",
        "-type",
        "d",
        "-name",
        "include"
    ], "", {}, 5000, 1048576)
    const linhasF: texto[] = resFind.saidaPadrao().dividir("\n")
    var candClang: texto = ""
    para (var i: inteiro = 0; i < linhasF.tamanho(); i++) {
        const d: texto = linhasF[i].aparar()
        se (d.tamanho() == 0) continua
        se (d.contem("install-tools") ou d.contem("plugin") ou d.contem("mingw")) continua
        se (texMod.Textos.comecaCom(d, "/usr/lib/gcc/x86_64-")) {
            freeDir = d
            sustar
        }
        se (texMod.Textos.comecaCom(d, "/usr/lib/clang/") e candClang.tamanho() == 0) {
            candClang = d
        }
    }

    se (freeDir.tamanho() == 0 e candClang.tamanho() > 0) {
        freeDir = candClang
    }

    se (freeDir.tamanho() > 0) {
        vistos[freeDir] = verdadeiro
        dirs.empilhar(freeDir)
    }

    const fixos: texto[] = ["/usr/local/include", "/usr/include/x86_64-linux-gnu", "/usr/include"]
    para (var i: inteiro = 0; i < fixos.tamanho(); i++) {
        const cand: texto = fixos[i]
        se (!vistos.contem(cand) e arqMod.Arquivo(cand).existe()) {
            vistos[cand] = verdadeiro
            dirs.empilhar(cand)
        }
    }

    se (!vistos.contem("/usr/include")) {
        dirs.empilhar("/usr/include")
    }

    retorna dirs
}

classe PreprocessadorDCC {
    macMod: qualquer
    exprMod: qualquer
    litMod: qualquer
    cls: qualquer
    bytesMod: qualquer
    camMod: qualquer
    TokKind: qualquer
    macros: dicionario
    pragmaOnceVistos: dicionario
    cacheLinhasArquivo: dicionario
    guardasInclude: dicionario
    dirsBusca: texto[]
    arquivos: qualquer
    diag: qualquer
    modoGnu: logico
    includesResolvidos: inteiro
    profundidadeInclude: inteiro
    profundidadeMacro: inteiro
    tokensExpandidosTotal: inteiro
    macrosExpandidasTotal: inteiro
    pilhaInclusao: texto[]

    construtor(dirsInclude: texto[], diag: qualquer, modoGnu: logico = falso) {
        isto.macMod = importar("pp_macros.delegua")
        isto.exprMod = importar("pp_expr.delegua")
        isto.litMod = importar("../lexer/literais.delegua")
        isto.cls = isto.litMod.ClassificadorChar()
        isto.bytesMod = importar("cgd:bytes")
        isto.camMod = importar("cgd:caminhos")
        isto.TokKind = isto.macMod.PPTokKind
        isto.macros = {}
        isto.pragmaOnceVistos = {}
        isto.cacheLinhasArquivo = {}
        isto.guardasInclude = {}
        isto.dirsBusca = []
        para (var i: inteiro = 0; i < dirsInclude.tamanho(); i++) {
            isto.dirsBusca.empilhar(dirsInclude[i])
        }
        isto.arquivos = importar("cgd:arquivos")
        isto.diag = diag
        isto.modoGnu = modoGnu
        isto.includesResolvidos = 0
        isto.profundidadeInclude = 0
        isto.profundidadeMacro = 0
        isto.tokensExpandidosTotal = 0
        isto.macrosExpandidasTotal = 0
        isto.pilhaInclusao = []

        // Macros padrao ISO C99 + ambiente Linux x86-64 LP64 (exigidas pelos headers reais do sistema)
        isto.definirObjeto("__STDC__", "1")
        isto.definirObjeto("__STDC_VERSION__", "199901L")
        isto.definirObjeto("__STDC_HOSTED__", "1")
        isto.definirObjeto("__DCC__", "1")
        isto.definirObjeto("__DCC_VERSION__", "200")
        isto.definirObjeto("__x86_64__", "1")
        isto.definirObjeto("__x86_64", "1")
        isto.definirObjeto("__amd64__", "1")
        isto.definirObjeto("__amd64", "1")
        isto.definirObjeto("__LP64__", "1")
        isto.definirObjeto("_LP64", "1")
        isto.definirObjeto("__linux__", "1")
        isto.definirObjeto("__unix__", "1")
        isto.definirObjeto("__ELF__", "1")
        isto.definirObjeto("__BYTE_ORDER__", "1234")
        isto.definirObjeto("__ORDER_LITTLE_ENDIAN__", "1234")
        isto.definirObjeto("__ORDER_BIG_ENDIAN__", "4321")
        isto.definirObjeto("__SIZE_TYPE__", "long unsigned int")
        isto.definirObjeto("__PTRDIFF_TYPE__", "long int")
        isto.definirObjeto("__WCHAR_TYPE__", "int")
        isto.definirObjeto("__WINT_TYPE__", "unsigned int")
        isto.definirObjeto("__INT8_TYPE__", "signed char")
        isto.definirObjeto("__INT16_TYPE__", "short int")
        isto.definirObjeto("__INT32_TYPE__", "int")
        isto.definirObjeto("__INT64_TYPE__", "long int")
        isto.definirObjeto("__UINT8_TYPE__", "unsigned char")
        isto.definirObjeto("__UINT16_TYPE__", "short unsigned int")
        isto.definirObjeto("__UINT32_TYPE__", "unsigned int")
        isto.definirObjeto("__UINT64_TYPE__", "long unsigned int")
        isto.definirObjeto("__INTMAX_TYPE__", "long int")
        isto.definirObjeto("__UINTMAX_TYPE__", "long unsigned int")
        isto.definirObjeto("__INTPTR_TYPE__", "long int")
        isto.definirObjeto("__UINTPTR_TYPE__", "long unsigned int")
        isto.definirObjeto("__CHAR_BIT__", "8")
        isto.definirObjeto("__SCHAR_MAX__", "127")
        isto.definirObjeto("__SHRT_MAX__", "32767")
        isto.definirObjeto("__INT_MAX__", "2147483647")
        isto.definirObjeto("__LONG_MAX__", "9223372036854775807L")
        isto.definirObjeto("__LONG_LONG_MAX__", "9223372036854775807LL")
        isto.definirObjeto("__SIZE_MAX__", "18446744073709551615UL")
        isto.definirObjeto("__SIZEOF_SHORT__", "2")
        isto.definirObjeto("__SIZEOF_INT__", "4")
        isto.definirObjeto("__SIZEOF_LONG__", "8")
        isto.definirObjeto("__SIZEOF_LONG_LONG__", "8")
        isto.definirObjeto("__SIZEOF_POINTER__", "8")
        isto.definirObjeto("__SIZEOF_SIZE_T__", "8")
        isto.definirObjeto("__SIZEOF_FLOAT__", "4")
        isto.definirObjeto("__SIZEOF_DOUBLE__", "8")
        isto.definirObjeto("__SIZEOF_LONG_DOUBLE__", "8")
        isto.definirObjeto("__FLT_RADIX__", "2")
        isto.definirObjeto("__FLT_MANT_DIG__", "24")
        isto.definirObjeto("__FLT_DIG__", "6")
        isto.definirObjeto("__FLT_MIN_EXP__", "(-125)")
        isto.definirObjeto("__FLT_MAX_EXP__", "128")
        isto.definirObjeto("__FLT_MIN__", "1.17549435e-38F")
        isto.definirObjeto("__FLT_MAX__", "3.40282347e+38F")
        isto.definirObjeto("__FLT_EPSILON__", "1.19209290e-07F")
        isto.definirObjeto("__DBL_MANT_DIG__", "53")
        isto.definirObjeto("__DBL_DIG__", "15")
        isto.definirObjeto("__DBL_MIN_EXP__", "(-1021)")
        isto.definirObjeto("__DBL_MAX_EXP__", "1024")
        isto.definirObjeto("__DBL_MIN__", "2.2250738585072014e-308")
        isto.definirObjeto("__DBL_MAX__", "1.7976931348623157e+308")
        isto.definirObjeto("__DBL_EPSILON__", "2.2204460492503131e-16")
        isto.definirObjeto("__LDBL_MANT_DIG__", "53")
        isto.definirObjeto("__LDBL_DIG__", "15")
        isto.definirObjeto("__LDBL_MIN_EXP__", "(-1021)")
        isto.definirObjeto("__LDBL_MAX_EXP__", "1024")
        isto.definirObjeto("__LDBL_MIN__", "2.2250738585072014e-308")
        isto.definirObjeto("__LDBL_MAX__", "1.7976931348623157e+308")
        isto.definirObjeto("__LDBL_EPSILON__", "2.2204460492503131e-16")
        isto.definirObjeto("__DECIMAL_DIG__", "17")
        isto.definirObjeto("__DATE__", "\"Nov 21 2026\"")
        isto.definirObjeto("__TIME__", "\"00:00:00\"")
        se (!modoGnu) {
            isto.definirObjeto("__STRICT_ANSI__", "1")
        }
    }

    copiarPilhaInclusao(): texto[] {
        var cp: texto[] = []
        para (var i: inteiro = 0; i < isto.pilhaInclusao.tamanho(); i++) {
            cp.empilhar(isto.pilhaInclusao[i])
        }
        retorna cp
    }

    definirObjeto(nome: texto, valorTexto: texto): vazio {
        const toks: qualquer[] = isto.macMod.tokenizarLinhaPP(valorTexto, 0, isto.cls)
        isto.macros[nome] = isto.macMod.MacroDef(nome, falso, falso, [], toks)
    }

    buscarArquivoInclude(nomeInc: texto, ehSistema: logico, dirAtual: texto, indiceInicial: inteiro = 0)

    : (texto, inteiro) {
        se (nomeInc.tamanho() == 0) retorna tupla(["", -1])
        se (!ehSistema e indiceInicial == 0) {
            const local: texto = isto.camMod.Caminhos.juntar([dirAtual, nomeInc])
            se (isto.arquivos.Arquivo(local).existe()) retorna tupla([local, -1])
        }
        para (var i: inteiro = indiceInicial; i < isto.dirsBusca.tamanho(); i++) {
            const cand: texto = isto.camMod.Caminhos.juntar([isto.dirsBusca[i], nomeInc])
            se (isto.arquivos.Arquivo(cand).existe()) retorna tupla([cand, i])
        }
        retorna tupla(["", -1])
    }

    expandirTokens(entrada: qualquer[], arquivoAtual: texto, linhaAtual: inteiro, modoIf: logico,
        dirAtual: texto, idxDirAtual: inteiro): qualquer[] {
        isto.profundidadeMacro++
        se (isto.profundidadeMacro > 128) {
            isto.diag.erroDireto(arquivoAtual, linhaAtual, 1, "profundidade maxima de expansao de macro excedida (limite 128)",
                "", "", "E1010", 1, isto.copiarPilhaInclusao())
        }

        var out: qualquer[] = []
        var i: inteiro = 0
        const n: inteiro = entrada.tamanho()
        const maxToksExpansao: inteiro = 50000
        const maxToksTotal: inteiro = 400000

        enquanto (i < n) {
            isto.tokensExpandidosTotal++
            se (out.tamanho() > maxToksExpansao ou isto.tokensExpandidosTotal > maxToksTotal) {
                isto.diag.erroDireto(arquivoAtual, linhaAtual, 1, "limite maximo de tokens expandidos por macros excedido (possivel expansao exponencial)",
                    "", "", "E1011", 1, isto.copiarPilhaInclusao())
            }
            const tok: qualquer = entrada[i]

            // Operador 'defined' em #if/#elif
            se (modoIf e tok.kind == isto.TokKind.Ident e tok.val == "defined") {
                var nomeMacro: texto = ""
                var avanco: inteiro = 1
                se (i + 1 < n e entrada[i + 1].val == "(") {
                    se (i + 3 < n e entrada[i + 2].kind == isto.TokKind.Ident e entrada[i + 3].val == ")") {
                        nomeMacro = entrada[i + 2].val
                        avanco = 4
                    } senao {
                        isto.diag.erroDireto(arquivoAtual, linhaAtual, 1, "sintaxe invalida em defined(...)",
                            "", "", "E1009", 1, isto.copiarPilhaInclusao())
                    }
                } senao se (i + 1 < n e entrada[i + 1].kind == isto.TokKind.Ident) {
                    nomeMacro = entrada[i + 1].val
                    avanco = 2
                } senao {
                    isto.diag.erroDireto(arquivoAtual, linhaAtual, 1, "identificador esperado apos 'defined'",
                        "", "", "E1009", 1, isto.copiarPilhaInclusao())
                }
                const existe: logico = isto.macros.contem(nomeMacro) ou nomeMacro == "__FILE__" ou nomeMacro == "__LINE__"
                out.empilhar(isto.macMod.PPToken(isto.TokKind.Num, existe ? "1" : "0", tok.espaco,
                    linhaAtual))
                i = i + avanco
                continua
            }

            // Predicados de pre-processamento modernos (__has_include, __has_attribute, __has_builtin, etc.)
            se (modoIf e tok.kind == isto.TokKind.Ident e (tok.val == "__has_include" ou tok.val == "__has_include_next" ou tok.val == "__has_attribute" ou tok.val == "__has_builtin" ou tok.val == "__has_extension" ou tok.val == "__has_feature" ou tok.val == "__glibc_has_attribute" ou tok.val == "__glibc_has_builtin" ou tok.val == "__glibc_has_extension")) {
                se (i + 1 < n e entrada[i + 1].val == "(") {
                    var j: inteiro = i + 2
                    var depthP: inteiro = 1
                    var argToks: qualquer[] = []
                    enquanto (j < n e depthP > 0) {
                        se (entrada[j].val == "(") depthP++
                        senao se (entrada[j].val == ")") {
                            depthP--
                            se (depthP == 0) sustar
                        }
                        argToks.empilhar(entrada[j])
                        j++
                    }
                    var resPred: texto = "0"
                    se (tok.val == "__has_include" ou tok.val == "__has_include_next") {
                        const alvoStr: texto = isto.macMod.renderizarTokensPP(argToks).aparar()
                        const ehSysH: logico = alvoStr.tamanho() >= 3 e alvoStr[0] == "<" e alvoStr[alvoStr.tamanho() - 1] == ">"
                        const ehLocH: logico = alvoStr.tamanho() >= 3 e alvoStr[0] == "\"" e alvoStr[alvoStr.tamanho() - 1] == "\""
                        se (ehSysH ou ehLocH) {
                            const nomeH: texto = alvoStr.fatiar(1, alvoStr.tamanho() - 1)
                            const iniIdx: inteiro = tok.val == "__has_include_next" ? idxDirAtual + 1 : 0
                            const achado: (texto, inteiro) = isto.buscarArquivoInclude(nomeH,
                                ehSysH, dirAtual, iniIdx)
                            se (achado[0].tamanho() > 0) resPred = "1"
                        }
                    } senao se (tok.val == "__has_builtin" ou tok.val == "__glibc_has_builtin") {
                        const bNome: texto = isto.macMod.renderizarTokensPP(argToks).aparar()
                        se (bNome == "__builtin_offsetof" ou bNome == "__builtin_va_start" ou bNome == "__builtin_va_arg") {
                            resPred = "1"
                        }
                    }
                    out.empilhar(isto.macMod.PPToken(isto.TokKind.Num, resPred, tok.espaco,
                        linhaAtual))
                    i = j + 1
                    continua
                }
            }

            // Operador _Pragma("...") (ISO C99 6.10.9)
            se (tok.kind == isto.TokKind.Ident e tok.val == "_Pragma") {
                se (i + 3 < n e entrada[i + 1].val == "(" e entrada[i + 2].kind == isto.TokKind.Str e entrada[i + 3].val == ")") {
                    i = i + 4
                    continua
                }
            }

            se (tok.kind != isto.TokKind.Ident) {
                out.empilhar(tok)
                i++
                continua
            }

            se (tok.val == "__LINE__") {
                out.empilhar(isto.macMod.PPToken(isto.TokKind.Num, texto(linhaAtual), tok.espaco,
                    linhaAtual))
                i++
                continua
            }
            se (tok.val == "__FILE__") {
                out.empilhar(isto.macMod.PPToken(isto.TokKind.Str, "\"" + arquivoAtual + "\"",
                    tok.espaco, linhaAtual))
                i++
                continua
            }

            se (!isto.macros.contem(tok.val) ou tok.hideSet.contem(tok.val)) {
                out.empilhar(tok)
                i++
                continua
            }

            const def: qualquer = isto.macros[tok.val]
            isto.macrosExpandidasTotal++
            se (isto.macrosExpandidasTotal > 50000) {
                isto.diag.erroDireto(arquivoAtual, linhaAtual, 1, "limite maximo de expansoes de macros excedido (possivel expansao exponencial)",
                    "", "", "E1011", 1, isto.copiarPilhaInclusao())
            }

            // Macro de objeto
            se (!def.ehFuncao) {
                var novoHide: dicionario = {}
                const chavesH: texto[] = tok.hideSet.chaves()
                para (var k: inteiro = 0; k < chavesH.tamanho(); k++) novoHide[chavesH[k]] = verdadeiro
                novoHide[def.nome] = verdadeiro

                var subst: qualquer[] = []
                para (var k: inteiro = 0; k < def.corpo.tamanho(); k++) {
                    const cp: qualquer = def.corpo[k].clonarComHide(novoHide)
                    se (k == 0) cp.espaco = tok.espaco
                    subst.empilhar(cp)
                }
                const colados: qualquer[] = isto.macMod.aplicarTokenPastingPP(subst, linhaAtual)
                const reexpandidos: qualquer[] = isto.expandirTokens(colados, arquivoAtual,
                    linhaAtual, modoIf, dirAtual, idxDirAtual)
                se (out.tamanho() + reexpandidos.tamanho() > maxToksExpansao) {
                    isto.diag.erroDireto(arquivoAtual, linhaAtual, 1, "limite maximo de tokens expandidos por macros excedido (possivel expansao exponencial)",
                        "", "", "E1011", 1, isto.copiarPilhaInclusao())
                }
                para (var k: inteiro = 0; k < reexpandidos.tamanho(); k++) out.empilhar(reexpandidos[k])
                i++
                continua
            }

            // Macro funcional exige '(' imediatamente apos o nome
            se (i + 1 >= n ou entrada[i + 1].val != "(") {
                out.empilhar(tok)
                i++
                continua
            }

            var argsBrutos: qualquer[] = []
            var argAtual: qualquer[] = []
            var depth: inteiro = 1
            var j: inteiro = i + 2
            enquanto (j < n e depth > 0) {
                const cur: qualquer = entrada[j]
                se (cur.val == "(") {
                    depth++
                    argAtual.empilhar(cur)
                } senao se (cur.val == ")") {
                    depth--
                    se (depth == 0) {
                        se (argAtual.tamanho() > 0 ou argsBrutos.tamanho() > 0 ou def.params.tamanho() > 0 ou def.ehVariadica) {
                            argsBrutos.empilhar(argAtual)
                        }
                    } senao {
                        argAtual.empilhar(cur)
                    }
                } senao se (cur.val == "," e depth == 1) {
                    argsBrutos.empilhar(argAtual)
                    argAtual = []
                } senao {
                    argAtual.empilhar(cur)
                }
                j++
            }
            se (depth != 0) {
                isto.diag.erroDireto(arquivoAtual, linhaAtual, 1, "invocacao de macro '${def.nome}' sem ')'",
                    "", "", "E1012", 1, isto.copiarPilhaInclusao())
            }

            var mapaBruto: dicionario = {}
            var mapaExpandido: dicionario = {}
            para (var p: inteiro = 0; p < def.params.tamanho(); p++) {
                const rawArg: qualquer[] = p < argsBrutos.tamanho() ? argsBrutos[p] : []
                mapaBruto[def.params[p]] = rawArg
                mapaExpandido[def.params[p]] = isto.expandirTokens(rawArg, arquivoAtual,
                    linhaAtual, modoIf, dirAtual, idxDirAtual)
            }
            se (def.ehVariadica) {
                var vaRaw: qualquer[] = []
                para (var p: inteiro = def.params.tamanho(); p < argsBrutos.tamanho(); p++) {
                    se (p > def.params.tamanho()) {
                        vaRaw.empilhar(isto.macMod.PPToken(isto.TokKind.Punct, ",", falso,
                            linhaAtual))
                    }
                    const subA: qualquer[] = argsBrutos[p]
                    para (var m: inteiro = 0; m < subA.tamanho(); m++) vaRaw.empilhar(subA[m])
                }
                mapaBruto["__VA_ARGS__"] = vaRaw
                mapaExpandido["__VA_ARGS__"] = isto.expandirTokens(vaRaw, arquivoAtual, linhaAtual,
                    modoIf, dirAtual, idxDirAtual)
            }

            var novoHide: dicionario = {}
            const chavesH: texto[] = tok.hideSet.chaves()
            para (var k: inteiro = 0; k < chavesH.tamanho(); k++) novoHide[chavesH[k]] = verdadeiro
            novoHide[def.nome] = verdadeiro

            var subst: qualquer[] = []
            var cIdx: inteiro = 0
            enquanto (cIdx < def.corpo.tamanho()) {
                const ct: qualquer = def.corpo[cIdx]
                // Extensao GNU: ', ##__VA_ARGS__' remove a virgula quando __VA_ARGS__ e vazio
                se (ct.val == "," e cIdx + 2 < def.corpo.tamanho() e def.corpo[cIdx + 1].kind == isto.TokKind.HashHash e def.corpo[cIdx + 2].val == "__VA_ARGS__" e mapaBruto.contem("__VA_ARGS__")) {
                    const vaB: qualquer[] = mapaBruto["__VA_ARGS__"]
                    se (vaB.tamanho() == 0) {
                        cIdx = cIdx + 3
                        continua
                    }
                    subst.empilhar(ct.clonarComHide(novoHide))
                    const vaE: qualquer[] = mapaExpandido["__VA_ARGS__"]
                    para (var m: inteiro = 0; m < vaE.tamanho(); m++) {
                        subst.empilhar(vaE[m].clonarComHide(novoHide))
                    }
                    cIdx = cIdx + 3
                    continua
                }
                // Stringification: #param
                se (ct.kind == isto.TokKind.Hash e cIdx + 1 < def.corpo.tamanho() e def.corpo[cIdx + 1].kind == isto.TokKind.Ident) {
                    const pNome: texto = def.corpo[cIdx + 1].val
                    se (mapaBruto.contem(pNome)) {
                        const sLit: texto = isto.macMod.stringificarTokensPP(mapaBruto[pNome])
                        subst.empilhar(isto.macMod.PPToken(isto.TokKind.Str, sLit, ct.espaco,
                            linhaAtual).clonarComHide(novoHide))
                        cIdx = cIdx + 2
                        continua
                    }
                }
                se (ct.kind == isto.TokKind.Ident e mapaBruto.contem(ct.val)) {
                    const antEhPaste: logico = cIdx > 0 e def.corpo[cIdx - 1].kind == isto.TokKind.HashHash
                    const proxEhPaste: logico = cIdx + 1 < def.corpo.tamanho() e def.corpo[cIdx + 1].kind == isto.TokKind.HashHash
                    const origem: qualquer[] = (antEhPaste ou proxEhPaste) ? mapaBruto[ct.val] : mapaExpandido[ct.val]
                    para (var m: inteiro = 0; m < origem.tamanho(); m++) {
                        const cp: qualquer = origem[m].clonarComHide(novoHide)
                        se (m == 0) cp.espaco = ct.espaco
                        subst.empilhar(cp)
                    }
                    cIdx++
                    continua
                }
                subst.empilhar(ct.clonarComHide(novoHide))
                cIdx++
            }

            const colados: qualquer[] = isto.macMod.aplicarTokenPastingPP(subst, linhaAtual)
            se (colados.tamanho() > 0) colados[0].espaco = tok.espaco
            const reexpandidos: qualquer[] = isto.expandirTokens(colados, arquivoAtual, linhaAtual,
                modoIf, dirAtual, idxDirAtual)
            para (var k: inteiro = 0; k < reexpandidos.tamanho(); k++) out.empilhar(reexpandidos[k])
            i = j
        }

        isto.profundidadeMacro--
        retorna out
    }

    definirMacroDaLinha(resto: texto, arquivoAtual: texto, numLinha: inteiro, linhaRaw: texto): vazio {
        const aparado: texto = resto.aparar()
        se (aparado.tamanho() == 0 ou !isto.cls.ehInicioIdent(aparado[0])) {
            isto.diag.erroDireto(arquivoAtual, numLinha, 1, "#define exige identificador valido",
                linhaRaw, "", "E1013", 1, isto.copiarPilhaInclusao())
        }
        var pos: inteiro = 0
        enquanto (pos < aparado.tamanho() e isto.cls.ehContIdent(aparado[pos])) pos++
        const nome: texto = aparado.fatiar(0, pos)

        // Em modo -std=gnu99, preserva __attribute__ como palavra-chave real da camada GNU (Cat A/B/C)
        se (isto.modoGnu e nome == "__attribute__") retorna

        se (pos < aparado.tamanho() e aparado[pos] == "(") {
            var fimParen: inteiro = pos + 1
            enquanto (fimParen < aparado.tamanho() e aparado[fimParen] != ")") fimParen++
            se (fimParen >= aparado.tamanho()) {
                isto.diag.erroDireto(arquivoAtual, numLinha, 1, "')' esperado em #define ${nome}",
                    linhaRaw, "", "E1013", 1, isto.copiarPilhaInclusao())
            }
            const listaParamsStr: texto = aparado.fatiar(pos + 1, fimParen).aparar()
            var params: texto[] = []
            var ehVariadica: logico = falso
            se (listaParamsStr.tamanho() > 0) {
                const partes: texto[] = listaParamsStr.dividir(",")
                para (var p: inteiro = 0; p < partes.tamanho(); p++) {
                    const pm: texto = partes[p].aparar()
                    se (pm == "...") {
                        ehVariadica = verdadeiro
                    } senao se (pm.tamanho() > 3 e pm.fatiar(pm.tamanho() - 3, pm.tamanho()) == "...") {
                        ehVariadica = verdadeiro
                        params.empilhar(pm.fatiar(0, pm.tamanho() - 3).aparar())
                    } senao {
                        params.empilhar(pm)
                    }
                }
            }
            const corpoStr: texto = aparado.fatiar(fimParen + 1, aparado.tamanho())
            const corpoToks: qualquer[] = isto.macMod.tokenizarLinhaPP(corpoStr, numLinha,
                isto.cls)
            isto.validarTokenPastingCorpo(corpoToks, arquivoAtual, numLinha, linhaRaw)
            isto.macros[nome] = isto.macMod.MacroDef(nome, verdadeiro, ehVariadica, params,
                corpoToks)
            retorna
        }

        const corpoStr: texto = aparado.fatiar(pos, aparado.tamanho())
        const corpoToks: qualquer[] = isto.macMod.tokenizarLinhaPP(corpoStr, numLinha, isto.cls)
        isto.validarTokenPastingCorpo(corpoToks, arquivoAtual, numLinha, linhaRaw)
        isto.macros[nome] = isto.macMod.MacroDef(nome, falso, falso, [], corpoToks)
    }

    validarTokenPastingCorpo(corpoToks: qualquer[], arquivoAtual: texto, numLinha: inteiro,
        linhaRaw: texto): vazio {
        se (corpoToks.tamanho() == 0) retorna
        se (corpoToks[0].kind == isto.TokKind.HashHash ou corpoToks[corpoToks.tamanho() - 1].kind == isto.TokKind.HashHash) {
            isto.diag.erroDireto(arquivoAtual, numLinha, 1, "'##' nao pode aparecer no inicio ou fim de uma definicao de macro",
                linhaRaw, "", "E1014", 2, isto.copiarPilhaInclusao())
        }
    }

    temMacroFuncionalAberta(toks: qualquer[]): logico {
        var i: inteiro = 0
        const n: inteiro = toks.tamanho()
        enquanto (i < n) {
            const t: qualquer = toks[i]
            se (t.kind == isto.TokKind.Ident e isto.macros.contem(t.val)) {
                const def: qualquer = isto.macros[t.val]
                se (def.ehFuncao e i + 1 < n e toks[i + 1].val == "(") {
                    var depth: inteiro = 1
                    var j: inteiro = i + 2
                    enquanto (j < n e depth > 0) {
                        se (toks[j].val == "(") depth++
                        senao se (toks[j].val == ")") depth--
                        j++
                    }
                    se (depth > 0) retorna verdadeiro
                    i = j
                    continua
                }
            }
            i++
        }
        retorna falso
    }

    processarFonte(fonteBruta: texto, nomeArquivo: texto, saidaGlobal: texto[], idxDirAtual: inteiro = -1): vazio {
        isto.profundidadeInclude++
        se (isto.profundidadeInclude > 64) {
            isto.diag.erroDireto(nomeArquivo, 1, 1, "profundidade maxima de #include excedida (limite 64)",
                "", "", "E1002", 1, isto.copiarPilhaInclusao())
        }

        var linhas: texto[] = []
        se (isto.cacheLinhasArquivo.contem(nomeArquivo) e fonteBruta.tamanho() == 0) {
            linhas = isto.cacheLinhasArquivo[nomeArquivo]
        } senao {
            const limpa: texto = fasesIniciaisELimpezaPP(fonteBruta, nomeArquivo, isto.diag,
                isto.copiarPilhaInclusao(), isto.bytesMod)
            linhas = limpa.dividir("\n")
            se (nomeArquivo.tamanho() > 0) isto.cacheLinhasArquivo[nomeArquivo] = linhas
        }
        var pilhaIf: QuadroIf[] = []
        var arquivoLogico: texto = nomeArquivo
        var deltaLinha: inteiro = 0
        const dirAtual: texto = isto.camMod.Caminhos.diretorio(nomeArquivo)
        const snapInc: texto[] = isto.copiarPilhaInclusao()
        var guardCandidato: texto = ""
        var guardElegivel: logico = nomeArquivo.tamanho() > 0
        var guardFechou: logico = falso

        var idx: inteiro = 0
        enquanto (idx < linhas.tamanho()) {
            const numLinha: inteiro = idx + 1 + deltaLinha
            const linhaRaw: texto = linhas[idx]
            const aparada: texto = linhaRaw.aparar()
            const ativoAtual: logico = pilhaIf.tamanho() == 0 ? verdadeiro : pilhaIf[pilhaIf.tamanho() - 1].esteAtivo

            se (aparada.tamanho() > 0 e guardFechou) {
                guardElegivel = falso
            }

            se (aparada.tamanho() > 0 e aparada[0] == "#") {
                const semHash: texto = aparada.fatiar(1, aparada.tamanho()).aparar()
                var fimDir: inteiro = 0
                enquanto (fimDir < semHash.tamanho() e isto.cls.ehContIdent(semHash[fimDir])) fimDir++
                const dirNome: texto = semHash.fatiar(0, fimDir)
                const resto: texto = semHash.fatiar(fimDir, semHash.tamanho()).aparar()

                se (guardCandidato.tamanho() == 0 e guardElegivel) {
                    se (dirNome == "ifndef" e pilhaIf.tamanho() == 0) {
                        var fIdG: inteiro = 0
                        enquanto (fIdG < resto.tamanho() e isto.cls.ehContIdent(resto[fIdG])) fIdG++
                        se (fIdG > 0 e resto.fatiar(fIdG, resto.tamanho()).aparar().tamanho() == 0) {
                            guardCandidato = resto.fatiar(0, fIdG)
                        } senao {
                            guardElegivel = falso
                        }
                    } senao {
                        guardElegivel = falso
                    }
                }

                se (dirNome == "ifdef" ou dirNome == "ifndef") {
                    se (pilhaIf.tamanho() >= 256) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "aninhamento maximo de diretivas #if excedido (limite 256)",
                            linhaRaw, "", "E1003", 1, snapInc)
                    }
                    var fimId: inteiro = 0
                    enquanto (fimId < resto.tamanho() e isto.cls.ehContIdent(resto[fimId])) fimId++
                    const idMacro: texto = resto.fatiar(0, fimId)
                    const definido: logico = isto.macros.contem(idMacro)
                    const cond: logico = dirNome == "ifdef" ? definido : !definido
                    pilhaIf.empilhar(QuadroIf(ativoAtual, ativoAtual e cond))
                    idx++
                    continua
                }
                se (dirNome == "if") {
                    se (pilhaIf.tamanho() >= 256) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "aninhamento maximo de diretivas #if excedido (limite 256)",
                            linhaRaw, "", "E1003", 1, snapInc)
                    }
                    var condVal: logico = falso
                    se (ativoAtual) {
                        const toksExpr: qualquer[] = isto.macMod.tokenizarLinhaPP(resto,
                            numLinha, isto.cls)
                        const expandidos: qualquer[] = isto.expandirTokens(toksExpr, arquivoLogico,
                            numLinha, verdadeiro, dirAtual, idxDirAtual)
                        condVal = isto.exprMod.AvaliadorExprPP(expandidos, isto.diag, arquivoLogico,
                            numLinha, isto.TokKind, linhaRaw, snapInc).avaliar() != 0
                    }
                    pilhaIf.empilhar(QuadroIf(ativoAtual, ativoAtual e condVal))
                    idx++
                    continua
                }
                se (dirNome == "elif") {
                    se (pilhaIf.tamanho() == 0) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "#elif sem #if",
                            linhaRaw, "", "E1003", 5, snapInc)
                    }
                    se (pilhaIf.tamanho() == 1) guardElegivel = falso
                    const q: QuadroIf = pilhaIf[pilhaIf.tamanho() - 1]
                    se (q.viuElse) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "#elif apos #else",
                            linhaRaw, "", "E1003", 5, snapInc)
                    }
                    se (!q.paiAtivo ou q.jaTomouRamo) {
                        q.esteAtivo = falso
                    } senao {
                        const toksExpr: qualquer[] = isto.macMod.tokenizarLinhaPP(resto,
                            numLinha, isto.cls)
                        const expandidos: qualquer[] = isto.expandirTokens(toksExpr, arquivoLogico,
                            numLinha, verdadeiro, dirAtual, idxDirAtual)
                        const condVal: logico = isto.exprMod.AvaliadorExprPP(expandidos,
                            isto.diag, arquivoLogico, numLinha, isto.TokKind, linhaRaw, snapInc).avaliar() != 0
                        q.esteAtivo = condVal
                        se (condVal) q.jaTomouRamo = verdadeiro
                    }
                    idx++
                    continua
                }
                se (dirNome == "else") {
                    se (pilhaIf.tamanho() == 0) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "#else sem #if",
                            linhaRaw, "", "E1003", 5, snapInc)
                    }
                    se (pilhaIf.tamanho() == 1) guardElegivel = falso
                    const q: QuadroIf = pilhaIf[pilhaIf.tamanho() - 1]
                    se (q.viuElse) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "#else duplicado",
                            linhaRaw, "", "E1003", 5, snapInc)
                    }
                    q.viuElse = verdadeiro
                    q.esteAtivo = q.paiAtivo e !q.jaTomouRamo
                    se (q.esteAtivo) q.jaTomouRamo = verdadeiro
                    idx++
                    continua
                }
                se (dirNome == "endif") {
                    se (pilhaIf.tamanho() == 0) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "#endif sem #if",
                            linhaRaw, "", "E1003", 6, snapInc)
                    }
                    se (pilhaIf.tamanho() == 1 e guardElegivel e guardCandidato.tamanho() > 0) {
                        guardFechou = verdadeiro
                    }
                    pilhaIf.removerUltimo()
                    idx++
                    continua
                }

                se (!ativoAtual) {
                    idx++
                    continua
                }

                se (dirNome == "define") {
                    isto.definirMacroDaLinha(resto, arquivoLogico, numLinha, linhaRaw)
                } senao se (dirNome == "undef") {
                    var fimIdU: inteiro = 0
                    enquanto (fimIdU < resto.tamanho() e isto.cls.ehContIdent(resto[fimIdU])) fimIdU++
                    const idUndef: texto = resto.fatiar(0, fimIdU)
                    se (isto.macros.contem(idUndef)) isto.macros.remover(idUndef)
                } senao se (dirNome == "include" ou dirNome == "include_next") {
                    var alvo: texto = resto
                    se (alvo.tamanho() > 0 e alvo[0] != "<" e alvo[0] != "\"") {
                        const expInc: qualquer[] = isto.expandirTokens(isto.macMod.tokenizarLinhaPP(alvo,
                            numLinha, isto.cls), arquivoLogico, numLinha, falso, dirAtual, idxDirAtual)
                        alvo = isto.macMod.renderizarTokensPP(expInc).aparar()
                    }
                    const ehSys: logico = alvo.tamanho() >= 3 e alvo[0] == "<" e alvo[alvo.tamanho() - 1] == ">"
                    const ehLoc: logico = alvo.tamanho() >= 3 e alvo[0] == "\"" e alvo[alvo.tamanho() - 1] == "\""
                    se (!ehSys e !ehLoc) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "sintaxe invalida em #${dirNome}: ${alvo}",
                            linhaRaw, "", "E1015", 1, snapInc)
                    }
                    const nomeArqInc: texto = alvo.fatiar(1, alvo.tamanho() - 1)
                    const iniDir: inteiro = dirNome == "include_next" ? idxDirAtual + 1 : 0
                    const achado: (texto, inteiro) = isto.buscarArquivoInclude(nomeArqInc,
                        ehSys, dirAtual, iniDir)
                    const caminhoResolvido: texto = achado[0]
                    se (caminhoResolvido.tamanho() == 0) {
                        isto.diag.erroDireto(arquivoLogico, numLinha, 1, "arquivo de cabecalho nao encontrado: '${nomeArqInc}'",
                            linhaRaw, "", "E1016", 1, snapInc)
                    }
                    var pularPorGuarda: logico = falso
                    se (isto.guardasInclude.contem(caminhoResolvido)) {
                        const idGuarda: texto = texto(isto.guardasInclude[caminhoResolvido])
                        se (isto.macros.contem(idGuarda)) pularPorGuarda = verdadeiro
                    }
                    se (!isto.pragmaOnceVistos.contem(caminhoResolvido) e !pularPorGuarda) {
                        isto.includesResolvidos++
                        se (isto.includesResolvidos > 2048) {
                            isto.diag.erroDireto(arquivoLogico, numLinha, 1, "limite maximo de #include por unidade de traducao excedido (2048)",
                                linhaRaw, "", "E1002", 1, snapInc)
                        }
                        const conteudoInc: texto = isto.cacheLinhasArquivo.contem(caminhoResolvido) ? "" : isto.arquivos.Arquivo(caminhoResolvido).ler()
                        isto.pilhaInclusao.empilhar("${arquivoLogico}:${numLinha}")
                        isto.processarFonte(conteudoInc, caminhoResolvido, saidaGlobal, achado[1])
                        isto.pilhaInclusao.removerUltimo()
                    }
                } senao se (dirNome == "error") {
                    isto.diag.erroDireto(arquivoLogico, numLinha, 1, "#error ${resto}", linhaRaw,
                        "", "E1020", 6, snapInc)
                } senao se (dirNome == "warning") {
                    isto.diag.avisoDireto(arquivoLogico, numLinha, 1, "#warning ${resto}",
                        linhaRaw, "", "cpp", "W1001", 8, snapInc)
                } senao se (dirNome == "line") {
                    const toksL: qualquer[] = isto.expandirTokens(isto.macMod.tokenizarLinhaPP(resto,
                        numLinha, isto.cls), arquivoLogico, numLinha, falso, dirAtual, idxDirAtual)
                    se (toksL.tamanho() >= 1 e toksL[0].kind == isto.TokKind.Num) {
                        const infoL: (inteiro, logico, logico) = isto.litMod.parseInteiroC99(toksL[0].val)
                        deltaLinha = infoL[0] - (idx + 2)
                        se (toksL.tamanho() >= 2 e toksL[1].kind == isto.TokKind.Str) {
                            arquivoLogico = toksL[1].val.fatiar(1, toksL[1].val.tamanho() - 1)
                        }
                    }
                } senao se (dirNome == "pragma") {
                    se (resto == "once") {
                        isto.pragmaOnceVistos[nomeArquivo] = verdadeiro
                    }
                } senao se (dirNome.tamanho() > 0) {
                    isto.diag.erroDireto(arquivoLogico, numLinha, 1, "diretiva desconhecida '#${dirNome}'",
                        linhaRaw, "", "E1017", 1, snapInc)
                }
                idx++
                continua
            }

            se (!ativoAtual ou aparada.tamanho() == 0) {
                idx++
                continua
            }

            se (guardCandidato.tamanho() == 0) guardElegivel = falso

            var toksLinha: qualquer[] = isto.macMod.tokenizarLinhaPP(linhaRaw, numLinha,
                isto.cls)
            enquanto (isto.temMacroFuncionalAberta(toksLinha) e idx + 1 < linhas.tamanho()) {
                const proxAparada: texto = linhas[idx + 1].aparar()
                se (proxAparada.tamanho() > 0 e proxAparada[0] == "#") sustar
                idx++
                const proxToks: qualquer[] = isto.macMod.tokenizarLinhaPP(linhas[idx], idx + 1 + deltaLinha,
                    isto.cls)
                se (proxToks.tamanho() > 0) proxToks[0].espaco = verdadeiro
                para (var m: inteiro = 0; m < proxToks.tamanho(); m++) toksLinha.empilhar(proxToks[m])
            }

            const expandidos: qualquer[] = isto.expandirTokens(toksLinha, arquivoLogico,
                numLinha, falso, dirAtual, idxDirAtual)
            const renderizada: texto = isto.macMod.renderizarTokensPP(expandidos)
            se (renderizada.aparar().tamanho() > 0) {
                saidaGlobal.empilhar(renderizada)
                isto.diag.mapaFonte.registrar(arquivoLogico, numLinha, linhaRaw, snapInc)
            }
            idx++
        }

        se (pilhaIf.tamanho() > 0) {
            isto.diag.erroDireto(arquivoLogico, linhas.tamanho(), 1, "diretiva #if/#ifdef/#ifndef sem #endif",
                "", "", "E1003", 1, snapInc)
        }
        se (guardElegivel e guardFechou e guardCandidato.tamanho() > 0) {
            isto.guardasInclude[nomeArquivo] = guardCandidato
        }
        isto.profundidadeInclude--
    }
}

funcao preprocessarDCC(fonte: texto, nomeArquivo: texto, dirsCli: texto[], defsCli: texto[],
    undefsCli: texto[], diag: qualquer, modoGnu: logico = falso): (texto, inteiro) {
    var dirsTodos: texto[] = []
    para (var i: inteiro = 0; i < dirsCli.tamanho(); i++) dirsTodos.empilhar(dirsCli[i])
    const dirsSys: texto[] = descobrirDirsSistema()
    para (var i: inteiro = 0; i < dirsSys.tamanho(); i++) dirsTodos.empilhar(dirsSys[i])

    const pp: PreprocessadorDCC = PreprocessadorDCC(dirsTodos, diag, modoGnu)
    para (var i: inteiro = 0; i < defsCli.tamanho(); i++) {
        const item: texto = defsCli[i]
        var posEq: inteiro = -1
        para (var k: inteiro = 0; k < item.tamanho(); k++) {
            se (item[k] == "=") {
                posEq = k
                sustar
            }
        }
        se (posEq < 0) pp.definirObjeto(item, "1")
        senao pp.definirObjeto(item.fatiar(0, posEq), item.fatiar(posEq + 1, item.tamanho()))
    }

    para (var i: inteiro = 0; i < undefsCli.tamanho(); i++) {
        se (pp.macros.contem(undefsCli[i])) pp.macros.remover(undefsCli[i])
    }

    var saidaGlobal: texto[] = []
    pp.processarFonte(fonte, nomeArquivo, saidaGlobal, -1)
    retorna tupla([saidaGlobal.juntar("\n"), pp.includesResolvidos])
}
